{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-fq__grid { display: grid; gap: 24px; }
  #{{ sid }} .sm-fq__head { display: grid; gap: 12px; justify-items: start; align-content: start; }
  #{{ sid }} .sm-fq__sub { color: var(--brand-muted); }
  #{{ sid }} .sm-fq__link { font-weight: 700; text-underline-offset: 4px; text-decoration-color: var(--brand-accent); text-decoration-thickness: 2px; }
  #{{ sid }} .sm-fq__list { display: grid; gap: 10px; }
  #{{ sid }} .sm-fq__item { border-radius: var(--radius); background: #fff; border: 1px solid var(--brand-border); }
  #{{ sid }} .sm-fq__item[open] { border-color: var(--brand-text); }
  #{{ sid }} .sm-fq__item summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 20px; font-weight: 700; font-size: 16px; cursor: pointer; list-style: none; }
  #{{ sid }} .sm-fq__item summary::-webkit-details-marker { display: none; }
  #{{ sid }} .sm-fq__ic { flex: none; padding: 6px; border-radius: 50%; background: var(--brand-bg-soft); box-sizing: content-box; transition: transform .25s, background .25s; }
  #{{ sid }} .sm-fq__item[open] .sm-fq__ic { transform: rotate(45deg); background: var(--brand-accent); }
  #{{ sid }} .sm-fq__a { padding: 0 20px 20px; color: var(--brand-muted); font-size: 15px; }
  #{{ sid }} .sm-fq__a p + p { margin-top: 8px; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-fq__grid { grid-template-columns: 4fr 7fr; gap: 56px; }
    #{{ sid }} .sm-fq__head { position: sticky; top: 24px; }
    #{{ sid }} .sm-fq__item summary { font-size: 17px; }
  }
</style>

<div id="{{ sid }}" class="sm-fq">
<div class="sm-wrap sm-fq__grid">
  <div class="sm-fq__head">
    {%- if section.settings.eyebrow != blank -%}<p class="sm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="sm-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="sm-sub sm-fq__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.btn_label != blank -%}<a class="sm-fq__link" href="{{ section.settings.btn_link | default: '#' }}">{{ section.settings.btn_label | escape }}</a>{%- endif -%}
  </div>
  <div class="sm-fq__list">
    {%- for block in section.blocks -%}
      <details class="sm-fq__item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question | escape }}<svg class="sm-fq__ic" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></summary>
        <div class="sm-fq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>
</div>

{% schema %}
{
  "name": "SM Questions fréquentes",
  "tag": "section",
  "class": "sm-shell sm-fq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne au-dessus du titre",
      "default": "Vos questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "On vous répond"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Une autre question ? Écrivez-nous, on répond en général dans la journée."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Lien : texte",
      "default": "Nous contacter"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Lien : adresse"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#eff6f9"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texte et titres",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Bouton : fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Bouton : texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Bouton : survol",
      "default": "#22405a"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#6fcfc8"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#d3e3ec"
    },
    {
      "type": "header",
      "content": "Polices"
    },
    {
      "type": "font_picker",
      "id": "font_head",
      "label": "Police des titres",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Police du texte",
      "default": "karla_n4"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Réponse.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "SM Questions fréquentes",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "question": "Dans quelles chaussures puis-je les mettre ?",
            "answer": "<p>Dans la plupart des chaussures fermées : baskets, bottes, chaussures de ville ou de travail. Retirez la semelle d'origine si elle s'enlève, puis glissez la Semelle Nuage à sa place.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Comment choisir ma taille ?",
            "answer": "<p>Prenez votre pointure habituelle. Si vous hésitez entre deux tailles, écrivez-nous avant de commander.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Comment les entretenir ?",
            "answer": "<p>Lavez-les à la main à l'eau tiède savonneuse, puis laissez-les sécher à l'air libre, loin d'un radiateur.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Et si elles ne me conviennent pas ?",
            "answer": "<p>Vous avez 30 jours pour les essayer. Si elles ne vous plaisent pas, contactez-nous et on vous rembourse.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Est-ce un produit médical ?",
            "answer": "<p>Non. La Semelle Nuage est une semelle de confort, pas un dispositif médical. En cas de douleur, consultez un professionnel de santé.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Comment fonctionnent les packs ?",
            "answer": "<p>Nos packs regroupent plusieurs produits pour moins cher que s'ils étaient achetés un par un. Par exemple, 2 paires de Semelle Nuage coûtent 49,90 € au lieu de 59,90 €. Vous choisissez la pointure de chaque paire. La livraison est offerte dès 39 € d'achat et le rouleau de massage est offert dès 69 €.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

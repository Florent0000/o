{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-foot__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 20px; }
  #{{ sid }} .sm-foot__brand { grid-column: 1 / -1; display: grid; gap: 12px; }
  #{{ sid }} .sm-foot__tag { font-weight: 600; font-size: 15px; line-height: 1.3; max-width: 320px; }
  #{{ sid }} .sm-foot__social { display: flex; gap: 14px; }
  #{{ sid }} .sm-foot__social a { color: inherit; display: inline-flex; }
  #{{ sid }} .sm-foot__h { font-weight: 600; margin-bottom: 8px; }
  #{{ sid }} .sm-foot__col ul { list-style: none; padding: 0; display: grid; gap: 10px; }
  #{{ sid }} .sm-foot__col a, #{{ sid }} .sm-foot__rte a { text-decoration: none; font-size: 14px; font-weight: 500; }
  #{{ sid }} .sm-foot__col a:hover { text-decoration: underline; }
  #{{ sid }} .sm-foot__rte { font-size: 14px; display: grid; gap: 8px; }
  #{{ sid }} .sm-foot__nl { grid-column: 1 / -1; }
  #{{ sid }} .sm-foot__form { display: flex; background: #fff; border-radius: 8px; overflow: hidden; }
  #{{ sid }} .sm-foot__form input[type=email] { flex: 1; min-width: 0; height: 44px; border: 0; padding: 0 14px; font: inherit; font-size: 14px; color: #13283a; background: #fff; }
  #{{ sid }} .sm-foot__form button { width: 48px; border: 0; background: var(--brand-btn-2); color: #fff; cursor: pointer; display: grid; place-items: center; }
  #{{ sid }} .sm-foot__bottom { margin-top: 28px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.2); font-size: 12px; opacity: .85; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-foot__grid { grid-template-columns: 1.6fr 1fr 1fr 1fr 1.8fr; gap: 24px; align-items: start; }
    #{{ sid }} .sm-foot__brand, #{{ sid }} .sm-foot__nl { grid-column: auto; }
  }
  #{{ sid }} .sm-foot__form { border-radius: 999px; }
  #{{ sid }} .sm-foot__form button { background: var(--brand-accent); color: #13283a; }

  #{{ sid }} .sm-foot__bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  #{{ sid }} .sm-foot__pay { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  #{{ sid }} .sm-foot__pay-ic { width: 38px; height: 24px; display: block; }
  #{{ sid }} .sm-foot__tag { font-weight: 500; opacity: .9; }
  #{{ sid }} .sm-foot__brandname { font-family: var(--font-head); font-weight: 700; font-size: 22px; letter-spacing: -0.01em; }
  #{{ sid }} .sm-foot__brandname img { display: block; width: var(--logo-w); max-width: 100%; height: auto; }
</style>

<div id="{{ sid }}" class="sm-foot">
<div class="sm-wrap sm-foot__grid">
  <div class="sm-foot__brand">
    {%- assign brand_name = section.settings.brand | default: shop.name -%}
    <p class="sm-foot__brandname" style="--logo-w: {{ section.settings.logo_width }}px">
      {%- if section.settings.logo != blank -%}{{ section.settings.logo | image_url: width: 480 | image_tag: alt: brand_name }}{%- else -%}{{ brand_name | escape }}{%- endif -%}
    </p>
    <p class="sm-foot__tag">{{ section.settings.tagline | escape }}</p>
    <div class="sm-foot__social">{%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 00-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0012 2z"/></svg></a>{%- endif -%}{%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}{%- if section.settings.youtube != blank -%}<a href="{{ section.settings.youtube }}" aria-label="Youtube" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21.6 7.2a2.5 2.5 0 00-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 002.4 7.2 26 26 0 002 12a26 26 0 00.4 4.8 2.5 2.5 0 001.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 001.8-1.8A26 26 0 0022 12a26 26 0 00-.4-4.8zM10 15V9l5.2 3z"/></svg></a>{%- endif -%}{%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" aria-label="Tiktok" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M16.6 3c.3 2.3 1.7 3.8 4 4v3.1a7 7 0 01-4-1.3v6.4A5.8 5.8 0 1110.8 9.4v3.2a2.6 2.6 0 102 2.6V3z"/></svg></a>{%- endif -%}</div>
  </div>
  {%- for block in section.blocks -%}
    <div class="sm-foot__col" {{ block.shopify_attributes }}>
      {%- if block.settings.heading != blank -%}<p class="sm-foot__h">{{ block.settings.heading | escape }}</p>{%- endif -%}
      {%- if block.type == 'links' -%}
        <ul>{%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}{%- for line in lines -%}{%- assign parts = line | split: '|' -%}{%- assign lt = parts[0] | strip -%}{%- assign lu = parts[1] | strip -%}{%- if lt != blank -%}<li><a href="{{ lu | default: '#' }}">{{ lt | escape }}</a></li>{%- endif -%}{%- endfor -%}</ul>
      {%- elsif block.type == 'menu' -%}
        <ul>{%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}</ul>
      {%- else -%}
        <div class="sm-foot__rte">{{ block.settings.text }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
  {%- if section.settings.show_newsletter -%}
    <div class="sm-foot__nl">
      {%- if section.settings.nl_title != blank -%}<p class="sm-foot__h">{{ section.settings.nl_title | escape }}</p>{%- endif -%}
      {%- form 'customer', class: 'sm-foot__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="sm-nl-{{ section.id }}" class="sm-vh">E-mail</label>
        <input id="sm-nl-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.nl_placeholder | escape }}">
        <button type="submit" aria-label="S'inscrire"><svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>
<div class="sm-wrap sm-foot__bottom">
  <p>© {{ 'now' | date: '%Y' }} {{ section.settings.brand | default: shop.name | escape }}</p>
  {%- if section.settings.show_payment -%}
    <ul class="sm-foot__pay" aria-label="Moyens de paiement">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'sm-foot__pay-ic' }}</li>{%- endfor -%}</ul>
  {%- endif -%}
</div>
</div>

{% schema %}
{
  "name": "SM Pied de page",
  "tag": "footer",
  "class": "sm-shell sm-foot",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Nom de marque (vide = nom de la boutique)",
      "default": "Heelo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (version claire pour fond foncé)",
      "info": "Mets heelo-logo-blanc.png (dossier logo). Vide = le nom de marque en texte."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largeur du logo",
      "min": 80,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Phrase de marque",
      "default": "Des semelles moelleuses pour toutes vos chaussures. Livraison offerte dès 39 €, satisfait ou remboursé pendant 30 jours."
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Afficher les logos de paiement",
      "default": true
    },
    {
      "type": "text",
      "id": "facebook",
      "label": "Lien Facebook"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Lien Instagram"
    },
    {
      "type": "text",
      "id": "youtube",
      "label": "Lien YouTube"
    },
    {
      "type": "text",
      "id": "tiktok",
      "label": "Lien TikTok"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Afficher l'inscription newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "nl_title",
      "label": "Titre newsletter",
      "default": "Offres et conseils par e-mail"
    },
    {
      "type": "text",
      "id": "nl_placeholder",
      "label": "Texte du champ e-mail",
      "default": "Votre e-mail"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texte et titres",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Bouton : fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Bouton : texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Bouton : survol",
      "default": "#22405a"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#6fcfc8"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#d3e3ec"
    },
    {
      "type": "header",
      "content": "Polices"
    },
    {
      "type": "font_picker",
      "id": "font_head",
      "label": "Police des titres",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Police du texte",
      "default": "karla_n4"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Liens",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre (optionnel)"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Liens (une ligne par lien : Texte | /adresse)"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre (optionnel)"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre (optionnel)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Une question sur votre pointure ?</p><p>Écrivez-nous, on vous répond sous 24 h.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "SM Pied de page",
      "blocks": [
        {
          "type": "links",
          "settings": {
            "heading": "Boutique",
            "links": "Best sellers | /collections/best-sellers\nSemelles | /collections/semelles\nSoins des pieds | /collections/soins-des-pieds\nClaquettes | /collections/claquettes\nTongs | /collections/tongs\nTout voir | /collections/all"
          }
        },
        {
          "type": "links",
          "settings": {
            "heading": "Aide",
            "links": "Suivre ma commande | /pages/suivre-ma-commande\nContact | /pages/contact\nLivraison | /policies/shipping-policy\nRetours et remboursements | /policies/refund-policy\nConditions générales | /policies/terms-of-service\nConfidentialité | /policies/privacy-policy\nMentions légales | /policies/legal-notice"
          }
        },
        {
          "type": "text",
          "settings": {
            "heading": "Contact"
          }
        }
      ]
    }
  ]
}
{% endschema %}

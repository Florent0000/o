{%- liquid
  assign sid = 'sm-' | append: section.id
  assign show = section.settings.show_public
  if request.design_mode
    assign show = true
  endif
-%}
{%- if show -%}
<style>

  
  
  #{{ sid }} {
    --brand-bg: #e4f0f6;
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: #13283a;
    --brand-heading: #13283a;
    --brand-btn: #13283a;
    --brand-btn-text: #ffffff;
    --brand-btn-hover: #22405a;
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: #6fcfc8;
    --brand-accent-dark: #17807b;
    --brand-border: #d3e3ec;
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: Archivo, 'Helvetica Neue', Arial, sans-serif;
    --font-body: Karla, 'Helvetica Neue', Arial, sans-serif;
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: 64px;
    --pb: 64px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-rev__grid { display: grid; gap: 28px; }
  #{{ sid }} .sm-rev__intro { display: grid; gap: 14px; justify-items: start; align-content: start; }
  #{{ sid }} .sm-rev__score { font-family: var(--font-head); font-weight: 700; font-size: 72px; line-height: 1; letter-spacing: -0.03em; }
  #{{ sid }} .sm-rev__rating { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  #{{ sid }} .sm-rev__rating span, #{{ sid }} .sm-rev__stars { display: inline-flex; gap: 2px; }
  #{{ sid }} .sm-rev__track { display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  #{{ sid }} .sm-rev__track::-webkit-scrollbar { display: none; }
  #{{ sid }} .sm-rev__card { scroll-snap-align: start; border-radius: var(--radius); min-height: 380px; margin: 0; overflow: hidden; }
  #{{ sid }} .sm-rev__card--video { border-radius: var(--radius-arch); }
  #{{ sid }} .sm-rev__card--text { background: var(--brand-bg-soft); border: 1px solid var(--brand-border); padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  #{{ sid }} .sm-rev__q { color: var(--brand-accent); }
  #{{ sid }} .sm-rev__quote { margin: 0; font-size: 18px; line-height: 1.5; flex: 1; }
  #{{ sid }} .sm-rev__card figcaption { display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid var(--brand-border); padding-top: 14px; }
  #{{ sid }} .sm-rev__name { font-weight: 700; font-size: 14px; }
  #{{ sid }} .sm-rev__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: var(--brand-accent); color: #13283a; }
  #{{ sid }} .sm-rev__nav { display: flex; gap: 8px; margin-top: 8px; }
  #{{ sid }} .sm-rev__arrow { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--brand-text); background: none; color: var(--brand-text); display: grid; place-items: center; cursor: pointer; }
  #{{ sid }} .sm-rev__arrow .sm-ic { width: 18px; height: 18px; }
  #{{ sid }} .sm-rev__arrow[disabled] { opacity: .3; cursor: default; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-rev__grid { grid-template-columns: 4fr 8fr; gap: 56px; align-items: start; }
    #{{ sid }} .sm-rev__track { grid-auto-columns: calc((100% - var(--gap)) / 2); }
    #{{ sid }} .sm-rev__score { font-size: 96px; }
  }

  #{{ sid }} .sm-rev__intro-t { color: var(--brand-muted); max-width: 380px; }
  #{{ sid }} .sm-rev__card--video { position: relative; min-height: 380px; }
  #{{ sid }} .sm-rev__card--video img, #{{ sid }} .sm-rev__card--video video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
#{{ sid }} .sm-gate{display:block;width:fit-content;max-width:calc(100% - 40px);margin:0 auto 20px;padding:8px 14px;border-radius:8px;background:#fff3cd;color:#6b4e00;font:600 13px/1.4 Karla,Arial,sans-serif;text-align:center}
</style>
<div class="sm-rev" id="{{ sid }}">{%- if request.design_mode and section.settings.show_public == false -%}<p class="sm-gate">Visible seulement dans l'éditeur : remplacez par de vrais avis clients, puis cochez « Afficher sur la boutique ».</p>{%- endif -%}
<div class="sm-wrap sm-rev__grid">
<div class="sm-rev__intro">{%- if section.settings.eyebrow != blank -%}<p class="sm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}<h2 class="sm-h2">{{ section.settings.heading | escape }}</h2>{%- if section.settings.intro != blank -%}<p class="sm-rev__intro-t">{{ section.settings.intro | escape }}</p>{%- endif -%}{%- if section.settings.btn_label != blank -%}<a class="sm-btn" href="{{ section.settings.btn_link | default: '#' }}">{{ section.settings.btn_label | escape }}</a>{%- endif -%}<div class="sm-rev__nav">
<button aria-label="Avis précédents" class="sm-rev__arrow" data-dir="-1" type="button"><svg aria-hidden="true" class="sm-ic" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24" width="24"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg></button>
<button aria-label="Avis suivants" class="sm-rev__arrow" data-dir="1" type="button"><svg aria-hidden="true" class="sm-ic" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewbox="0 0 24 24" width="24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
</div>
</div>
<div aria-label="Avis clients" class="sm-rev__track" tabindex="0">{%- for block in section.blocks -%}{%- case block.type -%}{%- when 'avis' -%}<figure class="sm-rev__card sm-rev__card--text" {{ block.shopify_attributes }}>
<svg aria-hidden="true" class="sm-rev__q" height="24" viewbox="0 0 32 24" width="32"><path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h6v12zm19 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h6v12z" fill="currentColor"></path></svg>
<blockquote class="sm-rev__quote">{{ block.settings.quote | escape }}</blockquote>
<figcaption><span class="sm-rev__stars" aria-label="{{ block.settings.stars }} sur 5">{%- for i in (1..block.settings.stars) -%}<svg aria-hidden="true" class="sm-star" height="16" viewbox="0 0 24 24" width="16"><path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z" fill="currentColor"></path></svg>{%- endfor -%}</span><span class="sm-rev__name">{{ block.settings.name | escape }}</span></figcaption>
</figure>{%- when 'photo' -%}<div class="sm-rev__card sm-rev__card--video sm-media" {{ block.shopify_attributes }}>{%- if block.settings.photo -%}{{ block.settings.photo | image_url: width: 1200 | image_tag: width: 600, height: 800, loading: 'lazy', alt: '' }}{%- elsif block.settings.photo_theme != blank -%}<img src="{{ block.settings.photo_theme | asset_url }}" width="600" height="800" loading="lazy" alt="">{%- endif -%}</div>{%- endcase -%}{%- endfor -%}</div>
</div>
</div>
<script>

(function(){var r=document.getElementById('{{ sid }}');if(!r)return;var t=r.querySelector('.sm-rev__track'),b=r.querySelectorAll('.sm-rev__arrow');if(!t)return;
function u(){b[0].disabled=t.scrollLeft<=2;b[1].disabled=t.scrollLeft+t.clientWidth>=t.scrollWidth-2;}
b.forEach(function(x){x.addEventListener('click',function(){var c=t.querySelector('.sm-rev__card');var w=c?c.getBoundingClientRect().width+16:t.clientWidth;t.scrollBy({left:w*parseInt(x.dataset.dir,10),behavior:'smooth'});});});
t.addEventListener('scroll',function(){window.requestAnimationFrame(u)});u();})();

</script>
{%- endif -%}

{% schema %}
{
  "name": "SM Avis clients",
  "tag": "section",
  "class": "sm-shell sm-rev",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_public",
      "label": "Afficher sur la boutique",
      "default": false,
      "info": "À cocher seulement avec de vrais avis de vrais clients (ou d'un vrai professionnel), publiés avec leur accord écrit. Tant que c'est décoché, la section n'est visible que dans l'éditeur."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne",
      "default": "Avis clients"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce que nos clients en disent"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Texte sous le titre",
      "default": "Remplace ces exemples par les vrais avis de tes clients avant de publier."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Bouton : texte",
      "default": "Choisir ma semelle"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Bouton : lien"
    }
  ],
  "presets": [
    {
      "name": "SM Avis clients"
    }
  ],
  "blocks": [
    {
      "type": "avis",
      "name": "Avis",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Avis (mots exacts du client)"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "name",
          "label": "Prénom et initiale"
        }
      ]
    },
    {
      "type": "photo",
      "name": "Photo client",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo (avec l'accord du client)"
        },
        {
          "type": "text",
          "id": "photo_theme",
          "label": "Photo du thème (si pas de photo choisie)"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}

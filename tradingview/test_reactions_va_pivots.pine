//@version=6
// =====================================================================================================
// TEST DES RÉACTIONS — VA PIVOTS (backtest honnête, à lancer sur ton graphique)
//
// Même calcul que tes deux indicateurs (Value Area de la séance RTH précédente, pivot = milieu
// VAH/VAL, extensions = largeur VA). Pour chaque niveau, chaque jour :
//   1) le prix touche le niveau pour la 1re fois de la séance
//   2) il arrive d'au-dessus  -> on teste un SUPPORT ; d'en dessous -> une RÉSISTANCE
//   3) RÉACTION si le prix repart de « distance » dans le sens du rebond AVANT d'aller de
//      « distance » de l'autre côté. Si les deux arrivent dans la même bougie : compté comme échec.
//
// TÉMOINS : deux niveaux sans signification (à mi-chemin entre VAH et 1A, et entre VAL et 1B).
// Sur des niveaux qui ne servent à rien, la réaction tourne autour de 50 %.
// Un niveau est utile seulement s'il fait NETTEMENT mieux que les témoins, avec assez de cas.
//
// Conseil : graphique en 5 min (plus d'historique qu'en 1 min).
// =====================================================================================================
indicator("Test réactions VA Pivots", overlay=true)

i_sess  = input.session("0930-1600", "Séance RTH (heure de New York)", tooltip="ES / NQ : 0930-1600. Pétrole : 0900-1430. Or : 0820-1330.")
i_tz    = input.string("America/New_York", "Fuseau des horaires", options=["America/New_York", "Bourse (comme l'indicateur d'origine)"],
     tooltip="« Bourse » reproduit l'indicateur d'origine : sur les futures CME, c'est l'heure de Chicago (1 h de moins que New York).")
i_va    = input.float(70.0, "Value Area %", minval=10.0, maxval=95.0, step=1.0)
i_d     = input.float(0.25, "Distance de réaction (× largeur de la VA)", minval=0.05, maxval=2.0, step=0.05)
i_rth   = input.bool(true, "Tester seulement pendant la séance RTH")
i_lines = input.bool(true, "Afficher les niveaux")

tzEff = i_tz == "America/New_York" ? "America/New_York" : syminfo.timezone
isRTH   = not na(time(timeframe.period, i_sess, tzEff))
rthOpen = isRTH and not isRTH[1]

// ------------------------------------------------------------------ Value Area (identique aux indicateurs)
computeVA(array<float> bHighs, array<float> bLows, array<float> bVols, float sH, float sL, float vaPct) =>
    int bins = 200
    float vahOut = na
    float valOut = na
    if not na(sH) and not na(sL) and sH > sL and array.size(bHighs) > 0
        float binSize = (sH - sL) / bins
        array<float> prof = array.new_float(bins, 0.0)
        float totVol = 0.0
        for b = 0 to array.size(bHighs) - 1
            float bv  = array.get(bVols, b)
            int iLow  = math.max(0, math.min(int(math.floor((array.get(bLows,  b) - sL) / binSize)), bins - 1))
            int iHigh = math.max(0, math.min(int(math.floor((array.get(bHighs, b) - sL) / binSize)), bins - 1))
            float vPer = bv / (iHigh - iLow + 1)
            for k = iLow to iHigh
                array.set(prof, k, array.get(prof, k) + vPer)
            totVol += bv
        int pocIdx = 0
        float pocVol = 0.0
        for i = 0 to bins - 1
            if array.get(prof, i) > pocVol
                pocVol := array.get(prof, i)
                pocIdx := i
        float target = totVol * vaPct / 100.0
        float acc = pocVol
        int upper = pocIdx
        int lower = pocIdx
        while acc < target and (upper < bins - 1 or lower > 0)
            float aVol = upper < bins - 1 ? array.get(prof, upper + 1) : 0.0
            float bVol = lower > 0        ? array.get(prof, lower - 1) : 0.0
            if upper >= bins - 1 or (lower > 0 and bVol > aVol)
                lower -= 1
                acc   += bVol
            else
                upper += 1
                acc   += aVol
        vahOut := sL + (upper + 1) * binSize
        valOut := sL + lower * binSize
    [vahOut, valOut]

var float sessHigh = na
var float sessLow  = na
var array<float> bh = array.new_float()
var array<float> bl = array.new_float()
var array<float> bv = array.new_float()
var float vah = na
var float val = na

// niveaux testés : 0 Pivot, 1 VAH, 2 VAL, 3 1A, 4 1B, 5 témoin haut, 6 témoin bas
var array<string> noms = array.from("Pivot", "VAH", "VAL", "1A", "1B", "Témoin haut", "Témoin bas")
var array<float> lv    = array.new_float(7, na)
var array<bool>  touch = array.new_bool(7, false)
var array<bool>  pend  = array.new_bool(7, false)
var array<int>   dirs  = array.new_int(7, 0)
var array<int>   nTot  = array.new_int(7, 0)
var array<int>   nWin  = array.new_int(7, 0)

if rthOpen
    [h_, l_] = computeVA(bh, bl, bv, sessHigh, sessLow, i_va)
    if not na(h_) and not na(l_) and h_ > l_
        vah := h_
        val := l_
        float rng = h_ - l_
        array.set(lv, 0, math.avg(h_, l_))
        array.set(lv, 1, h_)
        array.set(lv, 2, l_)
        array.set(lv, 3, h_ + rng)
        array.set(lv, 4, l_ - rng)
        array.set(lv, 5, h_ + 0.5 * rng)
        array.set(lv, 6, l_ - 0.5 * rng)
    for i = 0 to 6
        array.set(touch, i, false)
        array.set(pend, i, false)
    sessHigh := na
    sessLow  := na
    array.clear(bh)
    array.clear(bl)
    array.clear(bv)

if isRTH
    sessHigh := na(sessHigh) ? high : math.max(sessHigh, high)
    sessLow  := na(sessLow)  ? low  : math.min(sessLow,  low)
    array.push(bh, high)
    array.push(bl, low)
    array.push(bv, nz(volume, 1))

// ------------------------------------------------------------------ test des réactions
float prevClose = close[1]
if not na(vah) and (isRTH or not i_rth)
    float d = i_d * (vah - val)
    for i = 0 to 6
        float L = array.get(lv, i)
        if not na(L)
            if not array.get(touch, i) and low <= L and high >= L
                array.set(touch, i, true)
                array.set(pend, i, true)
                array.set(dirs, i, prevClose > L ? 1 : -1)
            if array.get(pend, i)
                bool up = high >= L + d
                bool dn = low  <= L - d
                if up or dn
                    int dr = array.get(dirs, i)
                    bool win = dr > 0 ? (up and not dn) : (dn and not up)
                    array.set(nTot, i, array.get(nTot, i) + 1)
                    if win
                        array.set(nWin, i, array.get(nWin, i) + 1)
                    array.set(pend, i, false)

// ------------------------------------------------------------------ affichage
plot(i_lines ? array.get(lv, 0) : na, "Pivot", color=color.lime, style=plot.style_stepline)
plot(i_lines ? array.get(lv, 1) : na, "VAH", color=color.gray, style=plot.style_stepline)
plot(i_lines ? array.get(lv, 2) : na, "VAL", color=color.gray, style=plot.style_stepline)
plot(i_lines ? array.get(lv, 3) : na, "1A", color=color.rgb(0, 150, 255), style=plot.style_stepline)
plot(i_lines ? array.get(lv, 4) : na, "1B", color=color.rgb(255, 50, 50), style=plot.style_stepline)
plot(i_lines ? array.get(lv, 5) : na, "Témoin haut", color=color.new(color.gray, 60), style=plot.style_circles)
plot(i_lines ? array.get(lv, 6) : na, "Témoin bas", color=color.new(color.gray, 60), style=plot.style_circles)

var table tb = table.new(position.bottom_right, 3, 9, bgcolor=color.new(color.black, 25), border_width=1)
if barstate.islast
    int tw = array.get(nTot, 5) + array.get(nTot, 6)
    float temoin = tw > 0 ? 100.0 * (array.get(nWin, 5) + array.get(nWin, 6)) / tw : na
    table.cell(tb, 0, 0, "Niveau", text_color=color.gray, text_size=size.small)
    table.cell(tb, 1, 0, "Cas", text_color=color.gray, text_size=size.small)
    table.cell(tb, 2, 0, "Réaction", text_color=color.gray, text_size=size.small)
    for i = 0 to 6
        int n = array.get(nTot, i)
        float r = n > 0 ? 100.0 * array.get(nWin, i) / n : na
        color c = na(r) or na(temoin) or i >= 5 ? color.white : r > temoin + 5 ? color.lime : r < temoin - 5 ? color.red : color.white
        table.cell(tb, 0, i + 1, array.get(noms, i), text_color=color.white, text_size=size.small)
        table.cell(tb, 1, i + 1, str.tostring(n), text_color=color.white, text_size=size.small)
        table.cell(tb, 2, i + 1, na(r) ? "-" : str.tostring(r, "#") + " %", text_color=c, text_size=size.small)
    table.cell(tb, 0, 8, "Fuseau : " + tzEff + " | témoins : " + (na(temoin) ? "-" : str.tostring(temoin, "#") + " %"), text_color=color.gray, text_size=size.tiny)
    table.merge_cells(tb, 0, 8, 2, 8)

{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-rev__grid { display: grid; gap: 28px; }
  #{{ sid }} .sm-rev__intro { display: grid; gap: 14px; justify-items: start; align-content: start; }
  #{{ sid }} .sm-rev__score { font-family: var(--font-head); font-weight: 700; font-size: 72px; line-height: 1; letter-spacing: -0.03em; }
  #{{ sid }} .sm-rev__rating { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  #{{ sid }} .sm-rev__rating span, #{{ sid }} .sm-rev__stars { display: inline-flex; gap: 2px; }
  #{{ sid }} .sm-rev__track { display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  #{{ sid }} .sm-rev__track::-webkit-scrollbar { display: none; }
  #{{ sid }} .sm-rev__card { scroll-snap-align: start; border-radius: var(--radius); min-height: 380px; margin: 0; overflow: hidden; }
  #{{ sid }} .sm-rev__card--video { border-radius: var(--radius-arch); }
  #{{ sid }} .sm-rev__card--text { background: var(--brand-bg-soft); border: 1px solid var(--brand-border); padding: 28px; display: flex; flex-direction: column; gap: 18px; }
  #{{ sid }} .sm-rev__q { color: var(--brand-accent); }
  #{{ sid }} .sm-rev__quote { margin: 0; font-size: 18px; line-height: 1.5; flex: 1; }
  #{{ sid }} .sm-rev__card figcaption { display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid var(--brand-border); padding-top: 14px; }
  #{{ sid }} .sm-rev__name { font-weight: 700; font-size: 14px; }
  #{{ sid }} .sm-rev__play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; background: var(--brand-accent); color: #13283a; }
  #{{ sid }} .sm-rev__nav { display: flex; gap: 8px; margin-top: 8px; }
  #{{ sid }} .sm-rev__arrow { width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--brand-text); background: none; color: var(--brand-text); display: grid; place-items: center; cursor: pointer; }
  #{{ sid }} .sm-rev__arrow .sm-ic { width: 18px; height: 18px; }
  #{{ sid }} .sm-rev__arrow[disabled] { opacity: .3; cursor: default; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-rev__grid { grid-template-columns: 4fr 8fr; gap: 56px; align-items: start; }
    #{{ sid }} .sm-rev__track { grid-auto-columns: calc((100% - var(--gap)) / 2); }
    #{{ sid }} .sm-rev__score { font-size: 96px; }
  }

  #{{ sid }} .sm-rev__intro-t { color: var(--brand-muted); max-width: 380px; }
  #{{ sid }} .sm-rev__card--video { position: relative; min-height: 380px; }
  #{{ sid }} .sm-rev__card--video img, #{{ sid }} .sm-rev__card--video video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} .sm-verif { display: inline-block; margin-left: 6px; font-weight: 600; font-size: 13px; color: inherit; white-space: nowrap; }
</style>

{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.type == 'video'
      if block.settings.video != blank
        assign filled = filled | plus: 1
      endif
    elsif block.settings.text != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
<div id="{{ sid }}" class="sm-rev">
<div class="sm-wrap sm-rev__grid">
  <div class="sm-rev__intro">
    {%- if section.settings.score != blank -%}<p class="sm-rev__score">{{ section.settings.score | escape }}</p>{%- endif -%}
    {%- if section.settings.score != blank -%}<p class="sm-rev__rating"><span><svg class="sm-star" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z"/></svg><svg class="sm-star" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z"/></svg><svg class="sm-star" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z"/></svg><svg class="sm-star" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z"/></svg><svg class="sm-star" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z"/></svg></span>{{ section.settings.rating | escape }}</p>{%- else -%}{%- if section.settings.eyebrow != blank -%}<p class="sm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}{%- endif -%}
    <h2 class="sm-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}<p class="sm-rev__intro-t">{{ section.settings.intro | escape }}</p>{%- endif -%}
    {%- if section.settings.btn_label != blank -%}<a href="{{ section.settings.btn_link }}" class="sm-btn">{{ section.settings.btn_label | escape }}</a>{%- endif -%}
    <div class="sm-rev__nav">
      <button type="button" class="sm-rev__arrow" data-dir="-1" aria-label="Avis précédents"><svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
      <button type="button" class="sm-rev__arrow" data-dir="1" aria-label="Avis suivants"><svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>
  </div>
  <div class="sm-rev__track" tabindex="0" aria-label="Avis clients">
    {%- for block in section.blocks -%}
      {%- if block.type == 'video' -%}
        <div class="sm-rev__card sm-rev__card--video sm-media" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: controls: true, preload: 'metadata', playsinline: true, image_size: '800x' }}
          {%- else -%}
            {%- if block.settings.poster != blank -%}{{ block.settings.poster | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, 80vw', class: '' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'sm-ph ' }}{%- endif -%}
          {%- endif -%}
        </div>
      {%- elsif block.settings.text != blank or request.design_mode -%}
        <figure class="sm-rev__card sm-rev__card--text" {{ block.shopify_attributes }}>
          <svg class="sm-rev__q" viewBox="0 0 32 24" width="32" height="24" aria-hidden="true"><path fill="currentColor" d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h6v12zm19 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h6v12z"/></svg>
          <blockquote class="sm-rev__quote">{{ block.settings.text | escape }}</blockquote>
          <figcaption><span class="sm-rev__stars">{%- for i in (1..block.settings.stars) -%}<svg class="sm-star" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z"/></svg>{%- endfor -%}</span><span class="sm-rev__name">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="sm-verif">✅ Achat vérifié</span>{% endif %}</span></figcaption>
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
</div>

<script>
(function(){var r=document.getElementById('sm-{{ section.id }}');if(!r)return;var t=r.querySelector('.sm-rev__track'),b=r.querySelectorAll('.sm-rev__arrow');if(!t)return;
function u(){b[0].disabled=t.scrollLeft<=2;b[1].disabled=t.scrollLeft+t.clientWidth>=t.scrollWidth-2;}
b.forEach(function(x){x.addEventListener('click',function(){var c=t.querySelector('.sm-rev__card');var w=c?c.getBoundingClientRect().width+16:t.clientWidth;t.scrollBy({left:w*parseInt(x.dataset.dir,10),behavior:'smooth'});});});
t.addEventListener('scroll',function(){window.requestAnimationFrame(u)});u();})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SM Avis clients",
  "tag": "section",
  "class": "sm-shell sm-rev",
  "settings": [
    {
      "type": "text",
      "id": "score",
      "label": "Grande note",
      "info": "Mets ta vraie note moyenne quand tu as des avis (ex. 4,7). Vide = pas de note affichée."
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Ligne d'avis",
      "default": "sur 5, d'après nos clients"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne (si pas de note)",
      "default": "Avis clients"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce que nos clients en disent"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Texte sous le titre",
      "default": "Remplace ces exemples par les vrais avis de tes clients avant de publier."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Bouton : texte",
      "default": "Choisir mon pack"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Bouton : lien"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#e4f0f6"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texte et titres",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Bouton : fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Bouton : texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Bouton : survol",
      "default": "#22405a"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#6fcfc8"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#d3e3ec"
    },
    {
      "type": "header",
      "content": "Polices"
    },
    {
      "type": "font_picker",
      "id": "font_head",
      "label": "Police des titres",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Police du texte",
      "default": "karla_n4"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Avis texte",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Étoiles",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Avis",
          "default": "Votre avis client ici."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Prénom N."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "✅ Achat vérifié",
          "info": "À cocher seulement si cette personne a vraiment commandé chez vous.",
          "default": false
        }
      ]
    },
    {
      "type": "video",
      "name": "Avis vidéo",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Vidéo"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Image si pas de vidéo"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "SM Avis clients",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "stars": 5,
            "name": "Prénom N.",
            "text": "Remplacez ce texte par le message de votre client, avec ses mots."
          }
        },
        {
          "type": "video",
          "settings": {}
        },
        {
          "type": "text",
          "settings": {
            "stars": 5,
            "name": "Prénom N.",
            "text": "Remplacez ce texte par le message de votre client, avec ses mots."
          }
        },
        {
          "type": "text",
          "settings": {
            "stars": 5,
            "name": "Prénom N.",
            "text": "Remplacez ce texte par le message de votre client, avec ses mots."
          }
        }
      ]
    }
  ]
}
{% endschema %}

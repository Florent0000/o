{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-tm__wrap { display: grid; justify-items: center; gap: 14px; text-align: center; }
  #{{ sid }} .sm-tm__note { display: inline-flex; align-items: center; padding: 7px 14px; border-radius: 999px; background: var(--brand-accent); color: #13283a; font-size: 13px; font-weight: 700; line-height: 1.3; }
  #{{ sid }} .sm-tm__list { list-style: none; margin: 14px calc(-1 * var(--gutter-mobile)) 0; padding: 0 var(--gutter-mobile) 4px; justify-self: stretch; display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 var(--gutter-mobile); scrollbar-width: none; }
  #{{ sid }} .sm-tm__list::-webkit-scrollbar { display: none; }
  #{{ sid }} .sm-tm__list--1 { grid-auto-columns: 100%; }
  #{{ sid }} .sm-tm__card { display: grid; justify-items: center; align-content: start; gap: 8px; scroll-snap-align: center; }
  #{{ sid }} .sm-tm__photo { position: relative; display: block; width: 170px; aspect-ratio: 1; margin-bottom: 10px; border-radius: 50%; overflow: hidden; background: var(--brand-bg-soft); border: 4px solid #fff; }
  #{{ sid }} .sm-tm__photo img, #{{ sid }} .sm-tm__photo svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} .sm-tm__title { font-family: var(--font-head); font-weight: 700; font-size: 18px; line-height: 1.3; letter-spacing: -0.01em; }
  #{{ sid }} .sm-tm__quote { color: var(--brand-muted); font-size: 15px; line-height: 1.55; max-width: 330px; }
  #{{ sid }} .sm-tm__name { font-weight: 700; font-size: 15px; }
  #{{ sid }} .sm-tm__empty { color: var(--brand-muted); font-size: 14px; max-width: 260px; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-tm__wrap { gap: 16px; }
    #{{ sid }} .sm-tm__list { margin: 24px 0 0; padding: 0; grid-auto-flow: row; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 40px; overflow: visible; max-width: calc(var(--cols) * 340px + (var(--cols) - 1) * 40px); justify-self: center; width: 100%; }
    #{{ sid }} .sm-tm__photo { width: 240px; }
    #{{ sid }} .sm-tm__title { font-size: 20px; }
    #{{ sid }} .sm-tm__quote { font-size: 16px; }
  }
  #{{ sid }} .sm-verif { display: inline-block; margin-left: 6px; font-weight: 600; font-size: 13px; color: inherit; white-space: nowrap; }
</style>

{%- liquid
  assign shown = 0
  for block in section.blocks
    if block.settings.photo != blank or block.settings.quote != blank
      assign shown = shown | plus: 1
    endif
  endfor
  assign ncols = shown
  if request.design_mode
    assign ncols = section.blocks.size
  endif
  if ncols > 3
    assign ncols = 3
  endif
-%}
{%- if shown > 0 or request.design_mode -%}
<div id="{{ sid }}" class="sm-tm">
<div class="sm-wrap sm-tm__wrap">
  {%- if section.settings.heading != blank -%}<h2 class="sm-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.note != blank -%}<p class="sm-tm__note">{{ section.settings.note | escape }}</p>{%- endif -%}
  <ul class="sm-tm__list{% if ncols == 1 %} sm-tm__list--1{% endif %}" role="list" style="--cols: {{ ncols | at_least: 1 }};">
    {%- for block in section.blocks -%}
      {%- assign has = false -%}
      {%- if block.settings.photo != blank or block.settings.quote != blank -%}{%- assign has = true -%}{%- endif -%}
      {%- if has or request.design_mode -%}
      <li class="sm-tm__card" {{ block.shopify_attributes }}>
        {%- if block.settings.photo != blank -%}
          <span class="sm-tm__photo">{{ block.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 240px, 170px', alt: '' }}</span>
        {%- elsif request.design_mode -%}
          <span class="sm-tm__photo">{{ 'image' | placeholder_svg_tag: 'sm-ph' }}</span>
        {%- endif -%}
        {%- if block.settings.title != blank -%}<p class="sm-tm__title">{{ block.settings.title | escape }}</p>{%- endif -%}
        {%- if block.settings.quote != blank -%}
          <p class="sm-tm__quote">« {{ block.settings.quote | escape }} »</p>
        {%- elsif request.design_mode -%}
          <p class="sm-tm__empty">Ajoutez la photo, la phrase et le prénom d'un vrai client (avec son accord écrit).</p>
        {%- endif -%}
        {%- if block.settings.name != blank or block.settings.verified -%}<p class="sm-tm__name">{{ block.settings.name | escape }}{% if block.settings.verified %} <span class="sm-verif">✅ Achat vérifié</span>{% endif %}</p>{%- endif -%}
      </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "SM Témoignages",
  "tag": "section",
  "class": "sm-shell sm-tm",
  "settings": [
    {
      "type": "paragraph",
      "content": "Mets uniquement de vrais clients, avec leur accord écrit pour la photo, le prénom et la phrase. Un bloc sans photo ni phrase est caché, et la section entière est cachée tant qu'aucun bloc n'est rempli."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Témoignages"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Petite pastille sous le titre (vide = pas de pastille)"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#e4f0f6"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texte et titres",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Bouton : fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Bouton : texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Bouton : survol",
      "default": "#22405a"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent (pastille)",
      "default": "#6fcfc8"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#d3e3ec"
    },
    {
      "type": "header",
      "content": "Polices"
    },
    {
      "type": "font_picker",
      "id": "font_head",
      "label": "Police des titres",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Police du texte",
      "default": "karla_n4"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "temoignage",
      "name": "Témoignage",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo du client (visage, carrée de préférence)",
          "info": "Le cercle zoome au centre. Utilise le point focal de Shopify pour centrer le visage."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre court",
          "info": "Par exemple les premiers mots de son avis."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Sa phrase, avec ses mots",
          "info": "Sans les guillemets, ils s'ajoutent tout seuls."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Prénom et initiale",
          "info": "Par exemple : Julie M."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "✅ Achat vérifié",
          "info": "À cocher seulement si cette personne a vraiment commandé chez vous.",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SM Témoignages",
      "blocks": [
        { "type": "temoignage" },
        { "type": "temoignage" },
        { "type": "temoignage" }
      ]
    }
  ]
}
{% endschema %}

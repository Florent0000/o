{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-bs__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 24px; margin-bottom: 28px; }
  #{{ sid }} .sm-bs__titles { display: grid; gap: 10px; max-width: 640px; }
  #{{ sid }} .sm-bs__sub { color: var(--brand-muted); }
  #{{ sid }} .sm-bs__all { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--brand-accent); padding-bottom: 2px; white-space: nowrap; }
  #{{ sid }} .sm-bs__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  #{{ sid }} .sm-bs__item { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  #{{ sid }} .sm-bs__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); background: var(--brand-bg-soft); border: 1px solid var(--brand-border); }
  #{{ sid }} .sm-bs__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .35s, transform .5s; }
  #{{ sid }} .sm-bs__img--2 { opacity: 0; }
  #{{ sid }} .sm-bs__item:hover .sm-bs__img--2 { opacity: 1; }
  #{{ sid }} .sm-bs__item:hover .sm-bs__img:only-of-type { transform: scale(1.03); }
  #{{ sid }} .sm-bs__tag { position: absolute; top: 10px; left: 10px; display: inline-flex; align-items: center; min-height: 26px; padding: 0 10px; border-radius: 999px; background: var(--brand-accent); color: #13283a; font-size: 12px; font-weight: 700; }
  #{{ sid }} .sm-bs__tag--ink { background: var(--brand-text); color: var(--brand-bg); }
  #{{ sid }} .sm-bs__info { display: grid; gap: 4px; }
  #{{ sid }} .sm-bs__name { font-size: 16px; line-height: 1.3; letter-spacing: -0.01em; }
  #{{ sid }} .sm-bs__name a { text-decoration: none; }
  #{{ sid }} .sm-bs__name a:hover { text-decoration: underline; text-underline-offset: 3px; }
  #{{ sid }} .sm-bs__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font-size: 15px; }
  #{{ sid }} .sm-bs__now { font-weight: 700; }
  #{{ sid }} .sm-bs__was { color: var(--brand-muted); font-size: 14px; }
  #{{ sid }} .sm-bs__form { margin: auto 0 0; }
  #{{ sid }} .sm-bs__add { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 44px; padding: 0 12px; border: 1px solid var(--brand-text); border-radius: 999px; background: transparent; color: var(--brand-text); font: 700 14px/1.2 var(--font-body); text-decoration: none; cursor: pointer; transition: background .2s, color .2s; }
  #{{ sid }} .sm-bs__add:hover { background: var(--brand-btn); border-color: var(--brand-btn); color: var(--brand-btn-text); }
  #{{ sid }} .sm-bs__more { display: none; }
  #{{ sid }} .sm-bs__add.is-off { opacity: .5; cursor: default; pointer-events: none; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-bs__head { margin-bottom: 40px; }
    #{{ sid }} .sm-bs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 24px; }
    #{{ sid }} .sm-bs__name { font-size: 18px; }
    #{{ sid }} .sm-bs__more { display: inline; }
    #{{ sid }} .sm-bs__price { font-size: 16px; }
  }
</style>

<div id="{{ sid }}" class="sm-bs">
<div class="sm-wrap">
  <div class="sm-bs__head">
    <div class="sm-bs__titles">
      {%- if section.settings.eyebrow != blank -%}<p class="sm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="sm-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="sm-sub sm-bs__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    {%- if section.settings.all_label != blank -%}
      <a class="sm-bs__all" href="{%- if section.settings.all_link != blank -%}{{ section.settings.all_link }}{%- elsif section.settings.collection != blank -%}{{ section.settings.collection.url }}{%- else -%}{{ routes.all_products_collection_url }}{%- endif -%}">{{ section.settings.all_label | escape }}<svg class="sm-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    {%- endif -%}
  </div>
  <ul class="sm-bs__grid" role="list">
    {%- if section.settings.cards != blank -%}
      {%- assign lines = section.settings.cards | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}
      {%- assign h = line | strip | split: '|' | first | strip -%}
      {%- if h == blank -%}{%- continue -%}{%- endif -%}
      {%- assign cp = all_products[h] -%}
      {%- if cp.id == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign f = line | strip | split: '|'
        assign cv = nil
        assign ccol = f[1] | strip
        if ccol != blank
          for v in cp.variants
            if v.options contains ccol
              assign cv = v
              break
            endif
          endfor
        endif
        assign curl = cp.url
        assign ctitle = cp.title
        assign cprice = cp.price
        assign cvaries = cp.price_varies
        assign cavail = cp.available
        if cv
          assign curl = cv.url
          assign ctitle = cp.title | append: ' - ' | append: ccol
          assign cprice = cv.price
          assign cvaries = false
          assign cavail = false
          for v in cp.variants
            if v.available and v.options contains ccol
              assign cavail = true
              break
            endif
          endfor
        endif
        assign cbadge = f[2] | strip
        assign cimg = f[3] | strip
        assign cimg2 = f[4] | strip
        assign cdes = f[6] | strip
        if cdes == 'dès'
          assign cvaries = true
        endif
      -%}
      <li class="sm-bs__item">
        <a class="sm-bs__media" href="{{ curl }}" tabindex="-1" aria-hidden="true">
          {%- if cimg != blank -%}
            <img src="{{ cimg | asset_url }}" loading="lazy" class="sm-bs__img" alt="{{ ctitle | escape }}">
          {%- elsif cv and cv.featured_image -%}
            {{ cv.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img', alt: ctitle }}
          {%- elsif cp.featured_image != blank -%}
            {{ cp.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img', alt: ctitle }}
          {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sm-ph sm-bs__img' }}{%- endif -%}
          {%- if section.settings.hover_image -%}
            {%- if cimg2 != blank -%}<img src="{{ cimg2 | asset_url }}" loading="lazy" class="sm-bs__img sm-bs__img--2" alt="">
            {%- elsif cv == nil and cp.images.size > 1 -%}{{ cp.images[1] | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img sm-bs__img--2', alt: '' }}{%- endif -%}
          {%- endif -%}
          {%- if cbadge != blank -%}<span class="sm-bs__tag">{{ cbadge | escape }}</span>{%- endif -%}
        </a>
        <div class="sm-bs__info">
          <h3 class="sm-bs__name"><a href="{{ curl }}">{{ ctitle | escape }}</a></h3>
          <p class="sm-bs__price">
            {%- if cvaries -%}<span class="sm-vh">À partir de</span>dès {% endif -%}
            <span class="sm-bs__now">{{ cprice | money }}</span>
            {%- if cv == nil and cp.compare_at_price > cp.price -%}<s class="sm-bs__was"><span class="sm-vh">Prix avant réduction</span>{{ cp.compare_at_price | money }}</s>{%- endif -%}
          </p>
        </div>
        {%- if section.settings.quick_add -%}
          {%- if cavail -%}<a class="sm-bs__add" href="{{ curl }}">Choisir la taille</a>{%- else -%}<span class="sm-bs__add is-off">Épuisé</span>{%- endif -%}
        {%- endif -%}
      </li>
      {%- endfor -%}
    {%- elsif section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      {%- assign shown = 0 -%}
      {%- for p in section.settings.collection.products -%}
      {%- if product and p.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- if shown >= section.settings.count -%}{%- break -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="sm-bs__item">
        <a class="sm-bs__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
          {%- if p.featured_image != blank -%}
            {{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img', alt: p.title }}
            {%- if section.settings.hover_image and p.images.size > 1 -%}{{ p.images[1] | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img sm-bs__img--2', alt: '' }}{%- endif -%}
          {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sm-ph sm-bs__img' }}{%- endif -%}
          {%- if p.tags contains 'recommande' -%}
            <span class="sm-bs__tag">★ Le plus recommandé</span>
          {%- elsif p.compare_at_price > p.price -%}
            {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
            <span class="sm-bs__tag">-{{ pct }} %</span>
          {%- elsif section.settings.tag_label != blank -%}<span class="sm-bs__tag">{{ section.settings.tag_label | escape }}</span>
          {%- endif -%}
        </a>
        <div class="sm-bs__info">
          <h3 class="sm-bs__name"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
          <p class="sm-bs__price">
            {%- if p.price_varies -%}<span class="sm-vh">À partir de</span>dès {% endif -%}
            <span class="sm-bs__now">{{ p.price | money }}</span>
            {%- if p.compare_at_price > p.price -%}<s class="sm-bs__was"><span class="sm-vh">Prix avant réduction</span>{{ p.compare_at_price | money }}</s>{%- endif -%}
          </p>
        </div>
        {%- if section.settings.quick_add -%}
          {%- if p.available and p.has_only_default_variant -%}
            {% form 'product', p, class: 'sm-bs__form' %}
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button type="submit" class="sm-bs__add"><svg class="sm-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span>Ajouter<span class="sm-bs__more"> au panier</span></span></button>
            {% endform %}
          {%- elsif p.available -%}
            <a class="sm-bs__add" href="{{ p.url }}">Choisir la taille</a>
          {%- else -%}
            <span class="sm-bs__add is-off">Épuisé</span>
          {%- endif -%}
        {%- endif -%}
      </li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li class="sm-bs__item">
          <div class="sm-bs__media">{{ 'product-' | append: i | placeholder_svg_tag: 'sm-ph sm-bs__img' }}</div>
          <div class="sm-bs__info"><h3 class="sm-bs__name">Choisis une collection</h3><p class="sm-bs__price"><span class="sm-bs__now">29,90 €</span></p></div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>
</div>

{% schema %}
{
  "name": "SM Best-sellers",
  "tag": "section",
  "class": "sm-shell sm-bs",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection à afficher",
      "info": "Crée une collection « Best-sellers » et ajoute-y tes produits."
    },
    {
      "type": "textarea",
      "id": "cards",
      "label": "Cartes à afficher (remplace la collection)",
      "info": "Une carte par ligne : poignée-produit|Couleur|Pastille|photo (fichier du thème)|photo au survol. Laisse Couleur vide pour le produit entier."
    },
    {
      "type": "range",
      "id": "count",
      "label": "Nombre de produits",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Afficher le bouton d'ajout au panier",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover_image",
      "label": "Montrer la 2e photo au survol",
      "default": true
    },
    {
      "type": "text",
      "id": "tag_label",
      "label": "Pastille si pas de réduction",
      "default": "Best-seller"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne au-dessus du titre",
      "default": "Les plus vendus"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Nos best-sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Les modèles que nos clients rachètent le plus souvent."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Lien « tout voir » : texte",
      "default": "Tout voir"
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "Lien « tout voir » : adresse",
      "info": "Vide = la collection choisie."
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#f6fafc"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texte et titres",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Bouton : fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Bouton : texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Bouton : survol",
      "default": "#22405a"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#6fcfc8"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#d3e3ec"
    },
    {
      "type": "header",
      "content": "Polices"
    },
    {
      "type": "font_picker",
      "id": "font_head",
      "label": "Police des titres",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Police du texte",
      "default": "karla_n4"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "SM Best-sellers"
    }
  ]
}
{% endschema %}

{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-bs__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px 24px; margin-bottom: 28px; }
  #{{ sid }} .sm-bs__titles { display: grid; gap: 10px; max-width: 640px; }
  #{{ sid }} .sm-bs__sub { color: var(--brand-muted); }
  #{{ sid }} .sm-bs__all { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--brand-accent); padding-bottom: 2px; white-space: nowrap; }
  #{{ sid }} .sm-bs__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  #{{ sid }} .sm-bs__item { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  #{{ sid }} .sm-bs__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); background: var(--brand-bg-soft); border: 1px solid var(--brand-border); }
  #{{ sid }} .sm-bs__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .35s, transform .5s; }
  #{{ sid }} .sm-bs__img--2 { opacity: 0; }
  #{{ sid }} .sm-bs__item:hover .sm-bs__img--2 { opacity: 1; }
  #{{ sid }} .sm-bs__item:hover .sm-bs__img:only-of-type { transform: scale(1.03); }
  #{{ sid }} .sm-bs__tag { position: absolute; top: 10px; left: 10px; display: inline-flex; align-items: center; min-height: 26px; padding: 0 10px; border-radius: 999px; background: var(--brand-accent); color: #13283a; font-size: 12px; font-weight: 700; }
  #{{ sid }} .sm-bs__tag--ink { background: var(--brand-text); color: var(--brand-bg); }
  #{{ sid }} .sm-bs__info { display: grid; gap: 4px; }
  #{{ sid }} .sm-bs__name { font-size: 16px; line-height: 1.3; letter-spacing: -0.01em; }
  #{{ sid }} .sm-bs__name a { text-decoration: none; }
  #{{ sid }} .sm-bs__name a:hover { text-decoration: underline; text-underline-offset: 3px; }
  #{{ sid }} .sm-bs__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; font-size: 15px; }
  #{{ sid }} .sm-bs__now { font-weight: 700; }
  #{{ sid }} .sm-bs__was { color: var(--brand-muted); font-size: 14px; }
  #{{ sid }} .sm-bs__form { margin: auto 0 0; }
  #{{ sid }} .sm-bs__add { margin-top: auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 44px; padding: 0 12px; border: 1px solid var(--brand-text); border-radius: 999px; background: transparent; color: var(--brand-text); font: 700 14px/1.2 var(--font-body); text-decoration: none; cursor: pointer; transition: background .2s, color .2s; }
  #{{ sid }} .sm-bs__add:hover { background: var(--brand-btn); border-color: var(--brand-btn); color: var(--brand-btn-text); }
  #{{ sid }} .sm-bs__more { display: none; }
  #{{ sid }} .sm-bs__item[hidden] { display: none; }
  #{{ sid }} .sm-bs__add.is-off { opacity: .5; cursor: default; pointer-events: none; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-bs__head { margin-bottom: 40px; }
    #{{ sid }} .sm-bs__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 24px; }
    #{{ sid }} .sm-bs__name { font-size: 18px; }
    #{{ sid }} .sm-bs__more { display: inline; }
    #{{ sid }} .sm-bs__price { font-size: 16px; }
  }

  #{{ sid }} .sm-cm__head { display: grid; gap: 10px; margin-bottom: 20px; max-width: 720px; }
  #{{ sid }} .sm-cm__crumbs { font-size: 13px; color: var(--brand-muted); }
  #{{ sid }} .sm-cm__crumbs a { color: inherit; }
  #{{ sid }} .sm-cm__desc { color: var(--brand-muted); }
  #{{ sid }} .sm-cm__cats { display: flex; gap: 8px; margin: 0 calc(-1 * var(--gutter-mobile, 16px)) 18px; padding: 2px var(--gutter-mobile, 16px) 6px; overflow-x: auto; scrollbar-width: none; }
  #{{ sid }} .sm-cm__cats::-webkit-scrollbar { display: none; }
  #{{ sid }} .sm-cm__cat { display: inline-flex; align-items: center; gap: 6px; flex: none; min-height: 40px; padding: 0 16px; border: 1.5px solid var(--brand-divider); border-radius: 999px; background: #fff; color: var(--brand-text); font-weight: 700; font-size: 14px; text-decoration: none; white-space: nowrap; transition: border-color .15s, background .15s, color .15s, transform .12s; }
  #{{ sid }} .sm-cm__cat:hover { border-color: var(--brand-text); }
  #{{ sid }} .sm-cm__cat:active { transform: scale(.95); }
  #{{ sid }} .sm-cm__cat .sm-ic { width: 16px; height: 16px; color: var(--brand-accent-dark); }
  #{{ sid }} .sm-cm__cat.is-on { background: var(--brand-text); border-color: var(--brand-text); color: var(--brand-bg); }
  #{{ sid }} .sm-cm__cat.is-on .sm-ic { color: var(--brand-accent); }
  #{{ sid }} .sm-cm__bar { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; margin-bottom: 20px; border-top: 1px solid var(--brand-border); border-bottom: 1px solid var(--brand-border); }
  #{{ sid }} .sm-cm__tools { display: flex; flex: 1; justify-content: flex-end; align-items: center; gap: 8px; min-width: 0; }
  #{{ sid }} .sm-cm__count { white-space: nowrap; }
  #{{ sid }} .sm-cm__filter summary { list-style: none; }
  #{{ sid }} .sm-cm__filter summary::-webkit-details-marker { display: none; }
  #{{ sid }} .sm-cm__fbtn { display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 14px; border: 1.5px solid var(--brand-divider); border-radius: 999px; background: #fff; font-weight: 700; font-size: 14px; cursor: pointer; }
  #{{ sid }} .sm-cm__filter[open] .sm-cm__fbtn { border-color: var(--brand-text); }
  #{{ sid }} .sm-cm__fbtn .sm-ic { width: 16px; height: 16px; }
  #{{ sid }} .sm-cm__fbtn b { display: grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--brand-accent); color: #13283a; font-size: 12px; }
  #{{ sid }} .sm-cm__fform { position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 5; display: grid; gap: 16px; max-height: 70vh; overflow-y: auto; padding: 18px; border: 1px solid var(--brand-border); border-radius: calc(var(--radius) * 2); background: #fff; box-shadow: 0 16px 40px rgba(19,40,58,.14); }
  #{{ sid }} .sm-cm__fset { margin: 0; padding: 0; border: 0; display: grid; gap: 8px; min-width: 0; }
  #{{ sid }} .sm-cm__fset legend { padding: 0; margin-bottom: 6px; font-family: var(--font-head); font-weight: 700; font-size: 15px; }
  #{{ sid }} .sm-cm__fopt { display: flex; align-items: center; gap: 10px; font-size: 14px; cursor: pointer; }
  #{{ sid }} .sm-cm__fopt input { width: 18px; height: 18px; margin: 0; accent-color: var(--brand-text); }
  #{{ sid }} .sm-cm__fopt small { margin-left: auto; color: var(--brand-muted); }
  #{{ sid }} .sm-cm__fopt:has(input:disabled) { opacity: .45; cursor: default; }
  #{{ sid }} .sm-cm__price { display: flex; flex-wrap: wrap; gap: 10px; }
  #{{ sid }} .sm-cm__price label { display: flex; align-items: center; gap: 6px; font-size: 14px; }
  #{{ sid }} .sm-cm__price input { width: 84px; padding: 8px 10px; border: 1.5px solid var(--brand-divider); border-radius: 10px; font: 700 14px/1.2 var(--font-body); }
  #{{ sid }} .sm-cm__factions { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 12px; border-top: 1px solid var(--brand-border); }
  #{{ sid }} .sm-cm__factions a { font-size: 14px; color: var(--brand-muted); }
  #{{ sid }} .sm-cm__factions .sm-btn { --btn-height: 42px; --btn-pad-x: 18px; font-size: 14px; }
  #{{ sid }} .sm-cm__count { font-size: 14px; font-weight: 700; }
  #{{ sid }} .sm-cm__sort { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  #{{ sid }} .sm-cm__sort span { display: none; }
  #{{ sid }} .sm-cm__sort select { padding: 8px 12px; border: 1.5px solid var(--brand-divider); border-radius: 999px; background: #fff; color: var(--brand-text); font: 700 14px/1.2 var(--font-body); max-width: 150px; }
  #{{ sid }} .sm-cm__pages { display: flex; justify-content: center; gap: 6px; margin-top: 36px; }
  #{{ sid }} .sm-cm__pages a, #{{ sid }} .sm-cm__pages span { display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 8px; border-radius: 999px; border: 1px solid var(--brand-border); text-decoration: none; font-weight: 700; }
  #{{ sid }} .sm-cm__pages [aria-current] { background: var(--brand-text); color: var(--brand-bg); border-color: var(--brand-text); }
  #{{ sid }} .sm-cm__empty { display: grid; justify-items: center; gap: 10px; padding: 48px 20px; text-align: center; border: 1px dashed var(--brand-divider); border-radius: var(--radius); background: var(--brand-bg-soft); }
  #{{ sid }} .sm-cm__more { display: grid; justify-items: center; gap: 12px; margin-top: 32px; text-align: center; }
  #{{ sid }} .sm-cm__seen { font-size: 14px; color: var(--brand-muted); }
  #{{ sid }} .sm-cm__seen b { color: var(--brand-text); }
  #{{ sid }} .sm-cm__prog { display: block; width: 100%; height: 3px; border-radius: 3px; background: var(--brand-border); overflow: hidden; }
  #{{ sid }} .sm-cm__prog span { display: block; height: 100%; background: var(--brand-text); transition: width .3s ease; }
  #{{ sid }} .sm-cm__morebtn { width: 100%; margin-top: 4px; }
  #{{ sid }} .sm-cm__morebtn.is-loading { opacity: .6; pointer-events: none; }
  #{{ sid }} .sm-cm__empty-t { font-family: var(--font-head); font-weight: 700; font-size: 22px; }
  #{{ sid }} .sm-cm__empty .sm-btn { margin-top: 8px; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-cm__cats { margin: 0 0 22px; padding: 2px 0 6px; flex-wrap: wrap; overflow: visible; }
    #{{ sid }} .sm-cm__sort span { display: inline; }
    #{{ sid }} .sm-cm__sort select { max-width: 200px; }
    #{{ sid }} .sm-cm__fform { left: auto; width: 380px; }
    #{{ sid }} .sm-cm__more { margin-top: 40px; }
    #{{ sid }} .sm-cm__prog { width: min(240px, 70%); }
    #{{ sid }} .sm-cm__morebtn { width: auto; min-width: 280px; background: transparent; color: var(--brand-text); border-color: var(--brand-text); }
    #{{ sid }} .sm-cm__morebtn:hover { background: var(--brand-text); border-color: var(--brand-text); color: #fff; }
  }
</style>

<div id="{{ sid }}" class="sm-bs sm-cm">
<div class="sm-wrap">
  <div class="sm-cm__head">
    {%- if section.settings.show_crumbs -%}<p class="sm-cm__crumbs"><a href="{{ routes.root_url }}">Accueil</a> / <span>{% if collection.handle == 'all' %}{{ section.settings.all_title | escape }}{% else %}{{ collection.title | escape }}{% endif %}</span></p>{%- endif -%}
    <h1 class="sm-h2">{% if collection.handle == 'all' %}{{ section.settings.all_title | escape }}{% else %}{{ collection.title | escape }}{% endif %}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}<div class="sm-sub sm-cm__desc">{{ collection.description }}</div>{%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <nav class="sm-cm__cats" aria-label="Catégories">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          if c != blank and c.products_count == 0 and section.settings.hide_empty
            continue
          endif
          assign url = block.settings.link
          assign label = block.settings.label
          if c != blank
            assign url = c.url
            if label == blank
              assign label = c.title
            endif
          endif
          assign on = false
          if c != blank and c.handle == collection.handle
            assign on = true
          elsif c == blank and url == collection.url
            assign on = true
          endif
        -%}
        <a class="sm-cm__cat{% if on %} is-on{% endif %}" href="{{ url | default: '#' }}"{% if on %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{%- case block.settings.icon -%}{%- when 'flame' -%}<svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c.5 3-2.5 4.5-2.5 7.5 0 1 .4 1.8 1 2.3-.2-1.6.8-2.8 2-3.3-.3 2 1.7 2.8 1.7 5 0 1.4-1 2.5-2.2 2.5 3 0 5-2 5-5.2C17 7.5 13.5 5.5 12 3z"/><path d="M7.5 12.5C6.6 13.6 6 15 6 16.3 6 19.4 8.7 21 12 21"/></svg>{%- when 'star' -%}<svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>{%- endcase -%}{{ label | escape }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
  {%- liquid
    assign use_cards = false
    if section.settings.cards != blank and collection.sort_by == blank
      assign use_cards = true
      for filter in collection.filters
        if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
          assign use_cards = false
        endif
      endfor
    endif
    assign pp = section.settings.per_page
    if use_cards
      assign pp = 50
    endif
  -%}
  {%- paginate collection.products by pp -%}
    {%- if use_cards -%}
      {%- assign n_cards = 0 -%}
      {%- capture cards_html -%}
      {%- assign lines = section.settings.cards | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}
        {%- assign ff = line | strip | split: '|' -%}
        {%- assign h = ff[0] | strip -%}
        {%- if h == blank -%}{%- continue -%}{%- endif -%}
        {%- assign hide_in = ff[5] | strip | split: ',' -%}
        {%- if hide_in contains collection.handle -%}{%- continue -%}{%- endif -%}
        {%- assign cp = nil -%}
        {%- for p in collection.products -%}{%- if p.handle == h -%}{%- assign cp = p -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- if cp == nil -%}{%- continue -%}{%- endif -%}
        {%- assign n_cards = n_cards | plus: 1 -%}
      {%- liquid
        assign f = line | strip | split: '|'
        assign cv = nil
        assign ccol = f[1] | strip
        if ccol != blank
          for v in cp.variants
            if v.options contains ccol
              assign cv = v
              break
            endif
          endfor
        endif
        assign curl = cp.url
        assign ctitle = cp.title
        assign cprice = cp.price
        assign cvaries = cp.price_varies
        assign cavail = cp.available
        if cv
          assign curl = cv.url
          assign ctitle = cp.title | append: ' - ' | append: ccol
          assign cprice = cv.price
          assign cvaries = false
          assign cavail = false
          for v in cp.variants
            if v.available and v.options contains ccol
              assign cavail = true
              break
            endif
          endfor
        endif
        assign cbadge = f[2] | strip
        assign cimg = f[3] | strip
        assign cimg2 = f[4] | strip
        assign cdes = f[6] | strip
        if cdes == 'dès'
          assign cvaries = true
        endif
      -%}
      <li class="sm-bs__item"{% if n_cards > section.settings.per_page %} hidden{% endif %}>
        <a class="sm-bs__media" href="{{ curl }}" tabindex="-1" aria-hidden="true">
          {%- if cimg != blank -%}
            <img src="{{ cimg | asset_url }}" loading="lazy" class="sm-bs__img" alt="{{ ctitle | escape }}">
          {%- elsif cv and cv.featured_image -%}
            {{ cv.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img', alt: ctitle }}
          {%- elsif cp.featured_image != blank -%}
            {{ cp.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img', alt: ctitle }}
          {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sm-ph sm-bs__img' }}{%- endif -%}
          {%- if section.settings.hover_image -%}
            {%- if cimg2 != blank -%}<img src="{{ cimg2 | asset_url }}" loading="lazy" class="sm-bs__img sm-bs__img--2" alt="">
            {%- elsif cv == nil and cp.images.size > 1 -%}{{ cp.images[1] | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img sm-bs__img--2', alt: '' }}{%- endif -%}
          {%- endif -%}
          {%- if cbadge != blank -%}<span class="sm-bs__tag">{{ cbadge | escape }}</span>{%- endif -%}
        </a>
        <div class="sm-bs__info">
          <h3 class="sm-bs__name"><a href="{{ curl }}">{{ ctitle | escape }}</a></h3>
          <p class="sm-bs__price">
            {%- if cvaries -%}<span class="sm-vh">À partir de</span>dès {% endif -%}
            <span class="sm-bs__now">{{ cprice | money }}</span>
            {%- if cv == nil and cp.compare_at_price > cp.price -%}<s class="sm-bs__was"><span class="sm-vh">Prix avant réduction</span>{{ cp.compare_at_price | money }}</s>{%- endif -%}
          </p>
        </div>
        {%- if section.settings.quick_add -%}
          {%- if cavail -%}<a class="sm-bs__add" href="{{ curl }}">Choisir la taille</a>{%- else -%}<span class="sm-bs__add is-off">Épuisé</span>{%- endif -%}
        {%- endif -%}
      </li>
      {%- endfor -%}
      {%- endcapture -%}
    <div class="sm-cm__bar">
      <p class="sm-cm__count">{{ n_cards }} produit{% if n_cards > 1 %}s{% endif %}</p>
      <div class="sm-cm__tools">
        {%- if section.settings.show_filters and collection.filters.size > 0 -%}
          <details class="sm-cm__filter">
            <summary class="sm-cm__fbtn"><svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg><span>Filtrer</span></summary>
            <form class="sm-cm__fform" action="{{ collection.url }}" method="get">
              {%- for filter in collection.filters -%}
                <fieldset class="sm-cm__fset">
                  <legend>{{ filter.label | escape }}</legend>
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <div class="sm-cm__price">
                        <label><span>De</span><input type="number" inputmode="numeric" min="0" step="1" name="{{ filter.min_value.param_name }}" placeholder="0"> €</label>
                        <label><span>à</span><input type="number" inputmode="numeric" min="0" step="1" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | divided_by: 100 }}"> €</label>
                      </div>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="sm-cm__fopt"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.count == 0 %} disabled{% endif %}><span>{{ value.label | escape }}</span><small>{{ value.count }}</small></label>
                      {%- endfor -%}
                  {%- endcase -%}
                </fieldset>
              {%- endfor -%}
              <div class="sm-cm__factions">
                <a href="{{ collection.url }}">Tout effacer</a>
                <button type="submit" class="sm-btn">Voir les produits</button>
              </div>
            </form>
          </details>
        {%- endif -%}
        {%- if section.settings.show_sort and n_cards > 1 -%}
        <label class="sm-cm__sort"><span>Trier</span>
          <select data-sort>
            {%- assign sort_by = collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
          </select>
        </label>
        {%- endif -%}
      </div>
    </div>
    {%- if n_cards > 0 -%}
      <ul class="sm-bs__grid" role="list">{{ cards_html }}</ul>
      {%- if n_cards > section.settings.per_page -%}
        {%- assign seen = section.settings.per_page -%}
        <div class="sm-cm__more" data-cards-more data-step="{{ section.settings.per_page }}">
          <p class="sm-cm__seen">Vous avez vu <b data-seen>{{ seen }}</b> produits sur <b>{{ n_cards }}</b></p>
          <span class="sm-cm__prog"><span data-bar style="width: {{ seen | times: 100 | divided_by: n_cards }}%"></span></span>
          <button type="button" class="sm-btn sm-cm__morebtn" data-cards-btn>{{ section.settings.more_label | escape }}</button>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="sm-cm__empty">
        <p class="sm-cm__empty-t">{{ section.settings.empty_title | escape }}</p>
        <p>{{ section.settings.empty_text | escape }}</p>
        <a class="sm-btn" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_btn | escape }}</a>
      </div>
    {%- endif -%}
    {%- else -%}
    <div class="sm-cm__bar">
      <p class="sm-cm__count">{{ collection.products_count }} produit{% if collection.products_count > 1 %}s{% endif %}</p>
      <div class="sm-cm__tools">
        {%- if section.settings.show_filters and collection.filters.size > 0 -%}
          {%- liquid
            assign n_active = 0
            for filter in collection.filters
              if filter.type == 'price_range'
                if filter.min_value.value or filter.max_value.value
                  assign n_active = n_active | plus: 1
                endif
              else
                assign n_active = n_active | plus: filter.active_values.size
              endif
            endfor
          -%}
          <details class="sm-cm__filter">
            <summary class="sm-cm__fbtn"><svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg><span>Filtrer</span>{% if n_active > 0 %}<b>{{ n_active }}</b>{% endif %}</summary>
            <form class="sm-cm__fform" action="{{ collection.url }}" method="get">
              {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by | escape }}">{%- endif -%}
              {%- for filter in collection.filters -%}
                <fieldset class="sm-cm__fset">
                  <legend>{{ filter.label | escape }}</legend>
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      <div class="sm-cm__price">
                        <label><span>De</span><input type="number" inputmode="numeric" min="0" step="1" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}" placeholder="0"> €</label>
                        <label><span>à</span><input type="number" inputmode="numeric" min="0" step="1" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}" placeholder="{{ filter.range_max | divided_by: 100 }}"> €</label>
                      </div>
                    {%- else -%}
                      {%- for value in filter.values -%}
                        <label class="sm-cm__fopt"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}><span>{{ value.label | escape }}</span><small>{{ value.count }}</small></label>
                      {%- endfor -%}
                  {%- endcase -%}
                </fieldset>
              {%- endfor -%}
              <div class="sm-cm__factions">
                <a href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}">Tout effacer</a>
                <button type="submit" class="sm-btn">Voir les produits</button>
              </div>
            </form>
          </details>
        {%- endif -%}
      {%- if section.settings.show_sort and collection.products_count > 1 -%}
        <label class="sm-cm__sort"><span>Trier</span>
          <select data-sort>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}
          </select>
        </label>
      {%- endif -%}
      </div>
    </div>
    {%- if collection.products.size > 0 -%}
      <ul class="sm-bs__grid" role="list">
        {%- for p in collection.products -%}
      <li class="sm-bs__item">
        <a class="sm-bs__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
          {%- if p.featured_image != blank -%}
            {{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img', alt: p.title }}
            {%- if section.settings.hover_image and p.images.size > 1 -%}{{ p.images[1] | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', class: 'sm-bs__img sm-bs__img--2', alt: '' }}{%- endif -%}
          {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sm-ph sm-bs__img' }}{%- endif -%}
          {%- if p.compare_at_price > p.price -%}
            {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
            <span class="sm-bs__tag">-{{ pct }} %</span>
          {%- elsif section.settings.tag_label != blank -%}<span class="sm-bs__tag sm-bs__tag--ink">{{ section.settings.tag_label | escape }}</span>
          {%- endif -%}
        </a>
        <div class="sm-bs__info">
          <h3 class="sm-bs__name"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
          <p class="sm-bs__price">
            {%- if p.price_varies -%}<span class="sm-vh">À partir de</span>dès {% endif -%}
            <span class="sm-bs__now">{{ p.price | money }}</span>
            {%- if p.compare_at_price > p.price -%}<s class="sm-bs__was"><span class="sm-vh">Prix avant réduction</span>{{ p.compare_at_price | money }}</s>{%- endif -%}
          </p>
        </div>
        {%- if section.settings.quick_add -%}
          {%- if p.available and p.has_only_default_variant -%}
            {% form 'product', p, class: 'sm-bs__form' %}
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button type="submit" class="sm-bs__add"><svg class="sm-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span>Ajouter<span class="sm-bs__more"> au panier</span></span></button>
            {% endform %}
          {%- elsif p.available -%}
            <a class="sm-bs__add" href="{{ p.url }}">Choisir la taille</a>
          {%- else -%}
            <span class="sm-bs__add is-off">Épuisé</span>
          {%- endif -%}
        {%- endif -%}
      </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 and section.settings.load_more -%}
        {%- assign seen = paginate.current_offset | plus: collection.products.size -%}
        <div class="sm-cm__more" data-more>
          <p class="sm-cm__seen">Vous avez vu <b>{{ seen }}</b> produits sur <b>{{ paginate.items }}</b></p>
          <span class="sm-cm__prog"><span style="width: {{ seen | times: 100 | divided_by: paginate.items }}%"></span></span>
          {%- if paginate.next -%}<a class="sm-btn sm-cm__morebtn" href="{{ paginate.next.url }}" data-more-btn>{{ section.settings.more_label | escape }}</a>{%- endif -%}
        </div>
      {%- elsif paginate.pages > 1 -%}
        <nav class="sm-cm__pages" aria-label="Pages">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Page précédente">‹</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Page suivante">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="sm-cm__empty">
        <p class="sm-cm__empty-t">{{ section.settings.empty_title | escape }}</p>
        <p>{{ section.settings.empty_text | escape }}</p>
        <a class="sm-btn" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_btn | escape }}</a>
      </div>
    {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>
</div>

<script>
(function () {
  var root = document.getElementById('{{ sid }}');
  var s = root && root.querySelector('[data-sort]');
  if (!s) return;
  s.addEventListener('change', function () {
    var u = new URL(window.location.href);
    u.searchParams.set('sort_by', s.value); u.searchParams.delete('page');
    window.location.href = u.toString();
  });
})();
(function () {
  var root = document.getElementById('{{ sid }}');
  var box = root && root.querySelector('[data-cards-more]');
  if (!box) return;
  var step = parseInt(box.getAttribute('data-step'), 10) || 8;
  box.querySelector('[data-cards-btn]').addEventListener('click', function () {
    var hid = root.querySelectorAll('.sm-bs__grid > li[hidden]');
    for (var i = 0; i < hid.length && i < step; i++) hid[i].hidden = false;
    var all = root.querySelectorAll('.sm-bs__grid > li').length, left = root.querySelectorAll('.sm-bs__grid > li[hidden]').length;
    box.querySelector('[data-seen]').textContent = all - left;
    box.querySelector('[data-bar]').style.width = Math.round((all - left) * 100 / all) + '%';
    if (!left) this.remove();
  });
})();
(function () {
  var root = document.getElementById('{{ sid }}');
  if (!root) return;
  root.addEventListener('click', function (e) {
    var a = e.target.closest('[data-more-btn]');
    if (!a) return;
    e.preventDefault();
    a.classList.add('is-loading');
    fetch(a.href).then(function (r) { return r.text(); }).then(function (t) {
      var next = new DOMParser().parseFromString(t, 'text/html').getElementById('{{ sid }}');
      var grid = root.querySelector('.sm-bs__grid');
      if (!next || !grid) { window.location.href = a.href; return; }
      next.querySelectorAll('.sm-bs__grid > li').forEach(function (li) { grid.appendChild(li); });
      var m = root.querySelector('[data-more]'), m2 = next.querySelector('[data-more]');
      if (m && m2) m.replaceWith(m2); else if (m) m.remove();
    }).catch(function () { window.location.href = a.href; });
  });
})();
</script>


      "blocks": {
        "row_1": {
          "type": "row",
          "settings": {
            "title": "Description",
            "content": "<p>Une semelle en mousse alvéolée, plus épaisse au talon. Elle remplace la semelle d'origine de vos chaussures. Trois hauteurs au choix : 1,5 cm, 2,5 cm ou 3,5 cm.</p>",
            "open": true,
            "use_description": false
          }
        },
        "row_2": {
          "type": "row",
          "settings": {
            "title": "Dans quelles chaussures ?",
            "content": "<p>Baskets, bottines, bottes : des chaussures fermées dont la semelle d'origine s'enlève. Évitez les chaussures très basses ou très ajustées, la rehausse prend de la place.</p>",
            "open": false,
            "use_description": false
          }
        },
        "row_3": {
          "type": "row",
          "settings": {
            "title": "Entretien",
            "content": "<p>Lavez-la à la main à l'eau tiède savonneuse, puis laissez-la sécher à l'air libre, loin d'un radiateur.</p>",
            "open": false,
            "use_description": false
          }
        },
        "row_4": {
          "type": "row",
          "settings": {
            "title": "Livraison et retours",
            "content": "<p>Les délais et frais de livraison s'affichent au moment de payer. Vous avez 30 jours pour essayer : si elle ne vous convient pas, on vous rembourse.</p>",
            "open": false,
            "use_description": false
          }
        }
      },

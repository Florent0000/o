{% raw %}<style>
.hx{--ink:#13283a;--mut:#52697b;--acc:#6fcfc8;--accd:#17807b;--soft:#eff6f9;--line:#d3e3ec;background:#f6fafc;color:var(--ink);font-family:Karla,'Helvetica Neue',Arial,sans-serif;font-size:17px;line-height:1.6;padding:56px 0}
.hx *{box-sizing:border-box}.hx--alt{background:#eff6f9}
.hx__wrap{max-width:1280px;margin:0 auto;padding:0 20px}
.hx h2{font-family:Archivo,'Helvetica Neue',Arial,sans-serif;font-weight:700;font-size:32px;line-height:1.1;letter-spacing:-.02em;margin:0;text-wrap:balance}
.hx h3{font-family:Archivo,'Helvetica Neue',Arial,sans-serif;font-weight:700;font-size:20px;line-height:1.2;margin:0}
.hx p{margin:0}.hx__eyebrow{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accd);margin-bottom:8px!important}
.hx__head{max-width:640px;margin-bottom:32px}.hx__head p{color:var(--mut);margin-top:10px}
.hx__steps{list-style:none;margin:0;padding:0;display:grid;gap:16px;counter-reset:s}
.hx__steps li{background:#fff;border:1px solid var(--line);border-radius:6px;padding:22px;display:grid;gap:6px;counter-increment:s}
.hx__steps li::before{content:counter(s);display:grid;place-items:center;width:40px;height:40px;border-radius:999px;background:var(--acc);font:700 18px/1 Archivo,Arial,sans-serif;margin-bottom:6px}
.hx__steps p,.hx__cards p{color:var(--mut);font-size:16px}
.hx__cards{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:repeat(2,minmax(0,1fr))}
.hx__cards li{display:grid;gap:8px;align-content:start}
.hx__cards img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:6px;background:var(--soft);display:block}
.hx__tablew{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:#fff}
.hx table{width:100%;border-collapse:collapse;min-width:560px;font-size:16px}
.hx th,.hx td{padding:14px 16px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
.hx thead th{font-family:Archivo,Arial,sans-serif;font-size:15px}
.hx thead th.is-us,.hx td.is-us{background:#e6f7f5}
.hx tbody tr:last-child td,.hx tbody tr:last-child th{border-bottom:0}
.hx tbody th{font-weight:600}
.hx__y{color:var(--accd);font-weight:700}.hx__n{color:var(--mut)}
.hx__note{color:var(--mut);font-size:14px;margin-top:12px!important}
.hx__roll{display:grid;gap:24px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:6px;padding:20px}
.hx__roll img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:6px;display:block}
.hx__roll .sm-pdp__title{font-family:Archivo,Arial,sans-serif;font-weight:700;font-size:26px;line-height:1.15;margin:0}
.hx__roll-t{display:grid;gap:12px}.hx__roll-t p{color:var(--mut)}
.hx__price{font:700 22px/1 Archivo,Arial,sans-serif;color:var(--ink)!important}
.hx__btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;border-radius:999px;border:2px solid #13283a;background:#13283a;color:#fff;font:700 16px/1.2 Karla,Arial,sans-serif;cursor:pointer}
.hx__btn:hover{background:#22405a;border-color:#22405a}
.hx__btn:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
mark.hx-todo{background:#fff4c2;color:#13283a;border-radius:4px;padding:0 6px;font-weight:700}
@media(min-width:750px){.hx{padding:80px 0}.hx__wrap{padding:0 40px}.hx h2{font-size:44px}
.hx__steps{grid-template-columns:repeat(3,minmax(0,1fr))}.hx__cards{grid-template-columns:repeat(4,minmax(0,1fr))}
.hx__roll{grid-template-columns:minmax(0,5fr) minmax(0,7fr);padding:28px;gap:40px}}
.hx-vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.hx-cap{margin:12px 0 0;font:15px/1.5 Karla,'Helvetica Neue',Arial,sans-serif;color:#52697b;min-height:3em}
.hx-hts{border:0;margin:0 0 18px;padding:0;min-width:0}.hx-hts .sm-pdp__label{margin-bottom:8px}
.hx-hts__row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.hx-ht{min-height:52px;border:1px solid #c9d8e2;border-radius:6px;background:#fff;color:#13283a;font:700 16px/1 Karla,Arial,sans-serif;cursor:pointer}
.hx-ht:hover{border-color:#13283a}.hx-ht.is-active{background:#13283a;border-color:#13283a;color:#fff}
.hx-ht:focus-visible{outline:2px solid #6fcfc8;outline-offset:2px}
.hx-hts__hint{margin:8px 0 0!important;font-size:14px;color:#52697b}
.hx__split{display:grid;gap:24px;align-items:center}
.hx__split img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:6px;display:block}
.hx__list{margin:16px 0 0;padding-left:20px;color:var(--mut)}.hx__list li{margin:4px 0}
.hx__link{display:inline-block;margin-left:16px;color:var(--accd);font-weight:700;text-decoration:underline;text-underline-offset:3px}
.hx__roll .sm-pdp__title{display:block}
.hx__cards--6 img{aspect-ratio:4/3}
.hx-fit{list-style:none;margin:0;padding:0;display:grid;gap:12px;grid-template-columns:repeat(2,minmax(0,1fr))}
.hx-fit li{background:#fff;border:1px solid var(--line);border-radius:6px;padding:18px;display:grid;gap:4px;align-content:start}
.hx-fit p{color:var(--mut);font-size:15px}
.hx-ok,.hx-no{display:grid;place-items:center;width:32px;height:32px;border-radius:999px;font:700 16px/1 Arial,sans-serif;margin-bottom:6px}
.hx-ok{background:#6fcfc8;color:#13283a}.hx-no{background:#eef1f4;color:#52697b}
.hx-bul{list-style:none;margin:16px 0 20px;padding:0;display:grid;gap:8px;font:600 16px/1.4 Karla,Arial,sans-serif;color:#13283a}
.hx-bul li{display:flex;gap:10px;align-items:center}
.hx-bul li::before{content:"✓";display:grid;place-items:center;flex:none;width:22px;height:22px;border-radius:999px;background:#6fcfc8;color:#13283a;font-size:13px;font-weight:700}
a.hx__btn{text-decoration:none;justify-self:start}
.hx__steps--img li img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:6px;display:block;margin-bottom:8px}
@media(min-width:750px){.hx-fit{grid-template-columns:repeat(4,minmax(0,1fr))}.hx__split{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px}.hx__cards.hx__cards--6{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>

<div id="sm-wr" class="hx hx--alt"><div class="hx__wrap"><div class="sm-pdp hx__roll"><img src="{% endraw %}{{ 'hp-rh-mousse.jpg' | asset_url }}{% raw %}" alt="Semelles Rehausse en mousse alvéolée" loading="lazy"><div class="hx__roll-t"><p class="hx__eyebrow">Pour aller avec</p><h2 class="sm-pdp__title">Semelle Rehausse</h2><p>Jusqu&#x27;à 3,5 cm au talon, avec la même mousse moelleuse que notre Semelle Heelo.</p><p class="hx__price"><span class="sm-pdp__now">29,95 €</span></p><a class="hx__btn" href="/products/semelle-rehausse">Voir la Semelle Rehausse</a></div></div></div></div>{% endraw %}

{% raw %}<style>
  
  
  #sm-r2 {
    --brand-bg: #f6fafc;
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: #13283a;
    --brand-heading: #13283a;
    --brand-btn: #13283a;
    --brand-btn-text: #ffffff;
    --brand-btn-hover: #22405a;
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: #6fcfc8;
    --brand-accent-dark: #17807b;
    --brand-border: #d3e3ec;
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: Archivo, 'Helvetica Neue', Arial, sans-serif;
    --font-body: Karla, 'Helvetica Neue', Arial, sans-serif;
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: 64px;
    --pb: 64px;
  }

  #sm-r2 { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #sm-r2 *, #sm-r2 *::before, #sm-r2 *::after { box-sizing: border-box; }
  #sm-r2 .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #sm-r2 h1, #sm-r2 h2, #sm-r2 h3, #sm-r2 h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #sm-r2 .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #sm-r2 p, #sm-r2 ul { margin: 0; }
  #sm-r2 a { color: inherit; }
  #sm-r2 img, #sm-r2 svg, #sm-r2 video { max-width: 100%; }
  #sm-r2 .sm-h2 { font-size: 32px; line-height: 1.1; }
  #sm-r2 .sm-sub { font-size: 16px; line-height: 1.5; }
  #sm-r2 .sm-ic { width: 20px; height: 20px; flex: none; }
  #sm-r2 .sm-ic-acc { stroke: var(--brand-accent); }
  #sm-r2 .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #sm-r2 .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #sm-r2 .sm-btn:active { transform: scale(.97); }
  #sm-r2 .sm-btn { -webkit-tap-highlight-color: transparent; }
  #sm-r2 .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #sm-r2 .sm-btn:focus-visible, #sm-r2 a:focus-visible, #sm-r2 button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #sm-r2 .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #sm-r2 .sm-media img, #sm-r2 .sm-media svg.sm-ph, #sm-r2 .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #sm-r2 svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #sm-r2 .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #sm-r2 .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #sm-r2 .sm-h2 { font-size: 52px; }
    #sm-r2 .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #sm-r2 * { transition: none !important; scroll-behavior: auto !important; } }

  #sm-r2 .sm-ft__head { display: grid; gap: 10px; margin-bottom: 28px; max-width: 640px; }
  #sm-r2 .sm-ft__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  #sm-r2 .sm-ft__card { display: grid; gap: 8px; align-content: start; min-width: 0; }
  #sm-r2 .sm-ft__media { aspect-ratio: var(--ft-ratio, 4 / 3); border-radius: var(--radius); margin-bottom: 6px; }
  #sm-r2 .sm-ft__num { position: absolute; left: 10px; top: 10px; z-index: 1; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-head); font-weight: 800; font-size: 14px; }
  #sm-r2 .sm-ft__title { font-size: 17px; line-height: 1.2; }
  #sm-r2 .sm-ft__text { font-size: 14px; color: var(--brand-muted); }
  @media (min-width: 750px) {
    #sm-r2 .sm-ft__head { margin-bottom: 40px; }
    #sm-r2 .sm-ft__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
    #sm-r2 .sm-ft__title { font-size: 20px; }
    #sm-r2 .sm-ft__text { font-size: 15px; }
  }
</style>


<div id="sm-r2" class="sm-ft">
<div class="sm-wrap">
  <div class="sm-ft__head"><p class="sm-eyebrow">Les avantages</p><h2 class="sm-h2">La même mousse que notre Semelle Heelo</h2>
  </div>
  <ol class="sm-ft__grid" role="list" style="--ft-ratio: 1 / 1;"><li class="sm-ft__card" >
        <div class="sm-ft__media sm-media"><img src="{% endraw %}{{ 'hp-rh-mousse-blanche.jpg' | asset_url }}{% raw %}" loading="lazy" class=""></div>
        <h3 class="sm-ft__title">Moelleuse sous le doigt</h3><p class="sm-ft__text">Une mousse épaisse qui s&#x27;enfonce en douceur puis reprend sa forme. Chaque pas est amorti.</p></li><li class="sm-ft__card" >
        <div class="sm-ft__media sm-media"><img src="{% endraw %}{{ 'hp-rh-aeration.jpg' | asset_url }}{% raw %}" loading="lazy" class=""></div>
        <h3 class="sm-ft__title">Respire à chaque pas</h3><p class="sm-ft__text">Des trous d&#x27;aération laissent passer l&#x27;air sous le pied, pour garder plus de fraîcheur dans la chaussure.</p></li><li class="sm-ft__card" >
        <div class="sm-ft__media sm-media"><img src="{% endraw %}{{ 'hp-rh-talon.jpg' | asset_url }}{% raw %}" loading="lazy" class=""></div>
        <h3 class="sm-ft__title">Talon rehaussé</h3><p class="sm-ft__text">Plus épaisse au talon : 1,5 cm, 2,5 cm ou 3,5 cm selon la hauteur choisie.</p></li><li class="sm-ft__card" >
        <div class="sm-ft__media sm-media"><img src="{% endraw %}{{ 'hp-rh-lavage.jpg' | asset_url }}{% raw %}" loading="lazy" class=""></div>
        <h3 class="sm-ft__title">Facile à entretenir</h3><p class="sm-ft__text">Un lavage à la main à l&#x27;eau tiède savonneuse, un séchage à l&#x27;air libre, et elle est prête.</p></li></ol>
</div>
</div>

{% endraw %}
{% schema %}
{
  "name": "Rehausse mousse",
  "tag": "div",
  "class": "sm-shell sm-static",
  "presets": [
    {
      "name": "Rehausse mousse"
    }
  ]
}
{% endschema %}

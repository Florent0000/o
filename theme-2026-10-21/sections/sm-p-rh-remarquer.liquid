{% raw %}<style>
#sm-rtm{--ink:#13283a;--muted:#52697b;background:#e4f0f6;color:var(--ink);font-family:Karla,'Helvetica Neue',Arial,sans-serif;font-size:16px;line-height:1.55;padding:48px 0 52px;-webkit-font-smoothing:antialiased}
#sm-rtm *{box-sizing:border-box}
#sm-rtm p{margin:0}
#sm-rtm .tm__wrap{max-width:1180px;margin:0 auto;padding:0 20px;display:grid;justify-items:center;gap:14px;text-align:center}
#sm-rtm h2{font:700 32px/1.1 Archivo,'Helvetica Neue',Arial,sans-serif;letter-spacing:-.02em;margin:0;color:var(--ink)}
#sm-rtm .tm__flag{display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;background:#6fcfc8;color:var(--ink);font-size:13px;font-weight:700;line-height:1.3}
#sm-rtm .tm__list{list-style:none;margin:14px -20px 0;padding:0 20px 4px;justify-self:stretch;display:grid;grid-auto-flow:column;grid-auto-columns:78%;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 20px;scrollbar-width:none}
#sm-rtm .tm__list::-webkit-scrollbar{display:none}
#sm-rtm .tm__card{display:grid;justify-items:center;align-content:start;gap:8px;scroll-snap-align:center}
#sm-rtm .tm__photo{display:block;width:170px;aspect-ratio:1;border-radius:50%;overflow:hidden;background:#eff6f9;border:4px solid #fff;margin-bottom:10px}
#sm-rtm .tm__photo img{display:block;width:100%;height:100%;object-fit:cover}
#sm-rtm .tm__title{font:700 18px/1.3 Archivo,'Helvetica Neue',Arial,sans-serif;letter-spacing:-.01em}
#sm-rtm .tm__quote{color:var(--muted);font-size:15px;max-width:330px}
#sm-rtm .tm__name{font-weight:700;font-size:15px}
@media (min-width:750px){#sm-rtm{padding:72px 0}#sm-rtm .tm__wrap{padding:0 40px;gap:16px}#sm-rtm h2{font-size:52px}
#sm-rtm .tm__list{margin:24px 0 0;padding:0;grid-auto-flow:row;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;overflow:visible}
#sm-rtm .tm__photo{width:240px}#sm-rtm .tm__title{font-size:20px}#sm-rtm .tm__quote{font-size:16px}}
</style>

<div id="sm-rtm" class="sm-tm"><div class="tm__wrap"><h2>Ce que vous allez remarquer</h2><ul class="tm__list" role="list"><li class="tm__card"><span class="tm__photo"><img src="{% endraw %}{{ 'hp-rh-discrete.jpg' | asset_url }}{% raw %}" alt="" loading="lazy" width="480" height="480"></span><p class="tm__title">Rien ne se voit</p><p class="tm__quote">La rehausse est à l&#x27;intérieur de la chaussure. De l&#x27;extérieur, vos baskets restent les mêmes.</p></li><li class="tm__card"><span class="tm__photo"><img src="{% endraw %}{{ 'hp-rh-tailles.jpg' | asset_url }}{% raw %}" alt="" loading="lazy" width="480" height="480"></span><p class="tm__title">Vous choisissez la hauteur</p><p class="tm__quote">1,5 cm, 2,5 cm ou 3,5 cm au talon. Commencez quelques heures par jour, le temps de vous habituer.</p></li><li class="tm__card"><span class="tm__photo"><img src="{% endraw %}{{ 'hp-rh-talon-dessus.jpg' | asset_url }}{% raw %}" alt="" loading="lazy" width="480" height="480"></span><p class="tm__title">De la mousse, pas un bloc dur</p><p class="tm__quote">La même mousse alvéolée que notre Semelle Heelo, sous tout le pied.</p></li></ul></div></div>{% endraw %}
{% schema %}
{
  "name": "Rehausse remarquer",
  "tag": "div",
  "class": "sm-shell sm-static",
  "presets": [
    {
      "name": "Rehausse remarquer"
    }
  ]
}
{% endschema %}

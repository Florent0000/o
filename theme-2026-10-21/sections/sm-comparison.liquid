{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-tb__grid { display: grid; gap: 28px; align-items: center; }
  #{{ sid }} .sm-tb__txt { display: grid; gap: 14px; justify-items: start; }
  #{{ sid }} .sm-tb__sub { color: var(--brand-muted); max-width: 440px; }
  #{{ sid }} .sm-tb__card { background: #fff; border: 1px solid var(--brand-border); border-radius: calc(var(--radius) * 2); padding: 0 6px 10px; }
  #{{ sid }} .sm-tb__table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; font-size: 12px; }
  #{{ sid }} .sm-tb__table th, #{{ sid }} .sm-tb__table td { padding: 12px 4px; text-align: center; vertical-align: middle; border-bottom: 1px solid var(--brand-border); line-height: 1.25; }
  #{{ sid }} .sm-tb__table tbody tr:last-child > * { border-bottom: 0; }
  #{{ sid }} .sm-tb__table thead th { vertical-align: bottom; font-family: var(--font-head); font-size: 12px; font-weight: 700; padding-top: 18px; color: var(--brand-muted); border-bottom: 0; }
  #{{ sid }} .sm-tb__table thead th:first-child { width: 34%; }
  #{{ sid }} .sm-tb__table tbody th { text-align: left; font-weight: 700; padding-left: 8px; }
  #{{ sid }} .sm-tb__table .sm-tb__us { background: var(--brand-text); color: #fff; border-bottom-color: rgba(255,255,255,.14); }
  #{{ sid }} .sm-tb__table thead .sm-tb__us { border-radius: var(--radius) var(--radius) 0 0; color: #fff; }
  #{{ sid }} .sm-tb__table thead .sm-tb__us > span:last-child { display: block; }
  #{{ sid }} .sm-tb__table tbody tr:last-child .sm-tb__us { border-radius: 0 0 var(--radius) var(--radius); }
  #{{ sid }} .sm-tb__thumb { display: block; width: 48px; height: 48px; margin: 0 auto 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 3px var(--brand-accent); }
  #{{ sid }} .sm-tb__yes { width: 20px; height: 20px; color: var(--brand-text); }
  #{{ sid }} .sm-tb__us .sm-tb__yes { color: var(--brand-accent); }
  #{{ sid }} .sm-tb__no { width: 15px; height: 15px; color: #bcd3df; }
  #{{ sid }} .sm-tb__note { margin: 8px 8px 0; font-size: 12px; color: var(--brand-muted); }
  @media (min-width: 750px) {
    #{{ sid }} .sm-tb__grid { grid-template-columns: 4fr 7fr; gap: 56px; }
    #{{ sid }} .sm-tb__card { padding: 0 14px 14px; }
    #{{ sid }} .sm-tb__table { font-size: 15px; }
    #{{ sid }} .sm-tb__table thead th { font-size: 15px; }
    #{{ sid }} .sm-tb__table th, #{{ sid }} .sm-tb__table td { padding: 16px 10px; }
    #{{ sid }} .sm-tb__thumb { width: 72px; height: 72px; }
  }
</style>

<div id="{{ sid }}" class="sm-tb">
<div class="sm-wrap sm-tb__grid">
  <div class="sm-tb__txt">
    {%- if section.settings.eyebrow != blank -%}<p class="sm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="sm-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="sm-sub sm-tb__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    {%- if section.settings.btn_label != blank -%}<a class="sm-btn" href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_label | escape }}</a>{%- endif -%}
  </div>
  <div class="sm-tb__card">
    <table class="sm-tb__table">
      <thead>
        <tr>
          <th scope="col"><span class="sm-vh">Critère</span></th>
          <th scope="col" class="sm-tb__us"><span class="sm-tb__thumb sm-media">{%- if section.settings.us_image_theme != blank -%}<img src="{{ section.settings.us_image_theme | asset_url }}" width="240" height="240" loading="lazy" alt="">{%- elsif section.settings.us_image != blank -%}{{ section.settings.us_image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '96px', class: '' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sm-ph ' }}{%- endif -%}</span><span>{{ section.settings.col_us | escape }}</span></th>
          <th scope="col">{{ section.settings.col_2 | escape }}</th>
          <th scope="col">{{ section.settings.col_3 | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.label | escape }}</th>
            <td class="sm-tb__us">{% if block.settings.us %}<svg class="sm-ic sm-tb__yes" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span class="sm-vh">Oui</span>{% else %}<svg class="sm-ic sm-tb__no" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg><span class="sm-vh">Non</span>{% endif %}</td>
            <td>{% if block.settings.c2 %}<svg class="sm-ic sm-tb__yes" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span class="sm-vh">Oui</span>{% else %}<svg class="sm-ic sm-tb__no" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg><span class="sm-vh">Non</span>{% endif %}</td>
            <td>{% if block.settings.c3 %}<svg class="sm-ic sm-tb__yes" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span class="sm-vh">Oui</span>{% else %}<svg class="sm-ic sm-tb__no" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg><span class="sm-vh">Non</span>{% endif %}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    {%- if section.settings.note != blank -%}<p class="sm-tb__note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</div>
</div>

{% schema %}
{
  "name": "SM Comparatif",
  "tag": "section",
  "class": "sm-shell sm-tb",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne au-dessus du titre",
      "default": "Le bon choix"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Pourquoi une Semelle Heelo ?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Plutôt qu'une semelle de magasin ou des semelles faites sur mesure : comparez avant de choisir."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Bouton : texte",
      "default": "Choisir ma semelle"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Bouton : lien"
    },
    {
      "type": "header",
      "content": "Colonnes"
    },
    {
      "type": "image_picker",
      "id": "us_image",
      "label": "Photo de votre produit (ronde)"
    },
    {
      "type": "text",
      "id": "us_image_theme",
      "label": "Photo : fichier du thème (facultatif)",
      "info": "Fichier du thème (ex. hp-nuage-echelle.jpg). Remplace la photo choisie au-dessus."
    },
    {
      "type": "text",
      "id": "col_us",
      "label": "Votre colonne",
      "default": "Semelle Heelo"
    },
    {
      "type": "text",
      "id": "col_2",
      "label": "Colonne 2",
      "default": "Semelles de magasin"
    },
    {
      "type": "text",
      "id": "col_3",
      "label": "Colonne 3",
      "default": "Soins spécialisés"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Petite mention sous le tableau",
      "default": "Comparaison générale. Les semelles de magasin et les semelles sur mesure varient selon les marques et les praticiens."
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#f6fafc"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texte et titres",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Bouton : fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Bouton : texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Bouton : survol",
      "default": "#22405a"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#6fcfc8"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#d3e3ec"
    },
    {
      "type": "header",
      "content": "Polices"
    },
    {
      "type": "font_picker",
      "id": "font_head",
      "label": "Police des titres",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Police du texte",
      "default": "karla_n4"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne du tableau",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Critère",
          "default": "Critère"
        },
        {
          "type": "checkbox",
          "id": "us",
          "label": "Votre produit",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "c2",
          "label": "Colonne 2",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "c3",
          "label": "Colonne 3",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SM Comparatif",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Mousse épaisse et moelleuse",
            "us": true,
            "c2": false,
            "c3": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Moulée sur votre pied",
            "us": false,
            "c2": false,
            "c3": true
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Sans rendez-vous ni ordonnance",
            "us": true,
            "c2": true,
            "c3": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Petit prix",
            "us": true,
            "c2": true,
            "c3": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Livrée chez vous",
            "us": true,
            "c2": false,
            "c3": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "30 jours pour essayer",
            "us": true,
            "c2": false,
            "c3": false
          }
        }
      ]
    }
  ]
}
{% endschema %}

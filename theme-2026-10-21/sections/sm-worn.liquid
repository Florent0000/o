{%- liquid
  assign fh = section.settings.font_head
  assign fb = section.settings.font_body
  assign fb6 = fb | font_modify: 'weight', '600'
  assign fb7 = fb | font_modify: 'weight', '700'
  assign sid = 'sm-' | append: section.id
-%}
<style>
  {{ fh | font_face: font_display: 'swap' }}
  {{ fb | font_face: font_display: 'swap' }}
  {%- if fb6 %}{{ fb6 | font_face: font_display: 'swap' }}{% endif %}
  {%- if fb7 %}{{ fb7 | font_face: font_display: 'swap' }}{% endif %}
  #{{ sid }} {
    --brand-bg: {{ section.settings.color_bg }};
    --brand-bg-alt: #e4f0f6;
    --brand-bg-soft: #eff6f9;
    --brand-text: {{ section.settings.color_text }};
    --brand-heading: {{ section.settings.color_text }};
    --brand-btn: {{ section.settings.color_btn }};
    --brand-btn-text: {{ section.settings.color_btn_text }};
    --brand-btn-hover: {{ section.settings.color_btn_hover }};
    --brand-btn-2: #6fcfc8;
    --brand-btn-2-text: #13283a;
    --brand-accent: {{ section.settings.color_accent }};
    --brand-accent-dark: #17807b;
    --brand-border: {{ section.settings.color_border }};
    --brand-divider: #bcd3df;
    --brand-star: #1f9d95;
    --brand-footer: #13283a;
    --brand-muted: #52697b;
    --radius-arch: 999px 999px 6px 6px;
    --font-head: {{ fh.family }}, {{ fh.fallback_families }};
    --font-body: {{ fb.family }}, {{ fb.fallback_families }};
    --radius: 6px;
    --radius-btn: 999px;
    --radius-lg: 6px;
    --section-pad: 64px;
    --max-width: 1280px;
    --gutter-mobile: 20px;
    --gap: 16px;
    --btn-height: 54px;
    --btn-pad-x: 24px;
    --pt: {{ section.settings.pad_top }}px;
    --pb: {{ section.settings.pad_bottom }}px;
  }

  #{{ sid }} { background: var(--brand-bg); color: var(--brand-text); font-family: var(--font-body); font-size: 17px; line-height: 1.6; padding: var(--pt) 0 var(--pb); -webkit-font-smoothing: antialiased; }
  #{{ sid }} *, #{{ sid }} *::before, #{{ sid }} *::after { box-sizing: border-box; }
  #{{ sid }} .sm-wrap { width: 100%; max-width: calc(var(--max-width) + 2 * var(--gutter-mobile)); margin: 0 auto; padding: 0 var(--gutter-mobile); }
  #{{ sid }} h1, #{{ sid }} h2, #{{ sid }} h3, #{{ sid }} h4 { font-family: var(--font-head); font-weight: 700; color: var(--brand-heading); margin: 0; letter-spacing: -0.02em; text-wrap: balance; }
  #{{ sid }} .sm-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-accent-dark); }
  #{{ sid }} p, #{{ sid }} ul { margin: 0; }
  #{{ sid }} a { color: inherit; }
  #{{ sid }} img, #{{ sid }} svg, #{{ sid }} video { max-width: 100%; }
  #{{ sid }} .sm-h2 { font-size: 32px; line-height: 1.1; }
  #{{ sid }} .sm-sub { font-size: 16px; line-height: 1.5; }
  #{{ sid }} .sm-ic { width: 20px; height: 20px; flex: none; }
  #{{ sid }} .sm-ic-acc { stroke: var(--brand-accent); }
  #{{ sid }} .sm-star { width: 16px; height: 16px; color: var(--brand-star); }
  #{{ sid }} .sm-btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--btn-height); padding: 0 var(--btn-pad-x); background: var(--brand-btn); color: var(--brand-btn-text); border: 2px solid var(--brand-btn); border-radius: var(--radius-btn); font-family: var(--font-body); font-weight: 700; font-size: 16px; line-height: 1.2; text-transform: none; letter-spacing: .01em; text-decoration: none; text-align: center; cursor: pointer; transition: background .2s, border-color .2s, transform .12s; }
  #{{ sid }} .sm-btn:active { transform: scale(.97); }
  #{{ sid }} .sm-btn { -webkit-tap-highlight-color: transparent; }
  #{{ sid }} .sm-btn:hover { background: var(--brand-btn-hover); border-color: var(--brand-btn-hover); }
  #{{ sid }} .sm-btn:focus-visible, #{{ sid }} a:focus-visible, #{{ sid }} button:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  #{{ sid }} .sm-media { position: relative; overflow: hidden; background: var(--brand-bg-soft); }
  #{{ sid }} .sm-media img, #{{ sid }} .sm-media svg.sm-ph, #{{ sid }} .sm-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #{{ sid }} svg.sm-ph { background: #dce9f0; fill: #bcd3df; }
  #{{ sid }} .sm-vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wrap { padding: 0 40px; max-width: calc(var(--max-width) + 80px); }
    #{{ sid }} .sm-h2 { font-size: 52px; }
    #{{ sid }} .sm-sub { font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { #{{ sid }} * { transition: none !important; scroll-behavior: auto !important; } }

  #{{ sid }} .sm-wo__grid { display: grid; gap: 32px; align-items: center; }
  #{{ sid }} .sm-wo__media { position: relative; max-width: 480px; width: 100%; justify-self: center; }
  #{{ sid }} .sm-wo__photo { aspect-ratio: 4 / 5; border-radius: var(--radius); }
  #{{ sid }} .sm-wo__photo img { filter: saturate(.8) contrast(1.03); }
  #{{ sid }} .sm-wo__sticker { position: absolute; right: -6px; top: 18px; transform: rotate(6deg); padding: 10px 16px; border-radius: 999px; background: var(--brand-accent); color: #13283a; font-family: var(--font-head); font-weight: 800; font-size: 15px; box-shadow: 0 8px 18px rgba(19,40,58,.18); }
  #{{ sid }} .sm-wo__txt { display: grid; gap: 18px; justify-items: start; }
  #{{ sid }} .sm-wo__sub { color: var(--brand-muted); }
  #{{ sid }} .sm-wo__signs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; width: 100%; }
  #{{ sid }} .sm-wo__signs li { display: flex; gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--brand-border); font-weight: 700; font-size: 16px; }
  #{{ sid }} .sm-wo__signs li:first-child { border-top: 1px solid var(--brand-border); }
  #{{ sid }} .sm-wo__signs .sm-ic { width: 22px; height: 22px; flex: none; color: var(--brand-accent-dark); }
  #{{ sid }} .sm-wo__photo img { filter: none; }
  #{{ sid }} .sm-wo__swap { width: 100%; display: grid; grid-template-columns: 64px 1fr; gap: 10px 14px; align-items: center; padding: 16px; border-radius: var(--radius); background: var(--brand-text); color: #fff; }
  #{{ sid }} .sm-wo__thumb { width: 64px; height: 64px; border-radius: 50%; background: #fff; }
  #{{ sid }} .sm-wo__swap-t { font-family: var(--font-head); font-weight: 700; font-size: 17px; line-height: 1.2; }
  #{{ sid }} .sm-wo__swap-txt p + p { font-size: 14px; color: rgba(255,255,255,.75); margin-top: 2px; }
  #{{ sid }} .sm-wo__btn { grid-column: 1 / -1; background: var(--brand-accent); border-color: var(--brand-accent); color: #13283a; }
  @media (min-width: 750px) {
    #{{ sid }} .sm-wo__grid { grid-template-columns: 5fr 6fr; gap: 64px; }
    #{{ sid }} .sm-wo__signs li { font-size: 18px; padding: 14px 0; }
    #{{ sid }} .sm-wo__swap { grid-template-columns: 72px 1fr auto; padding: 18px 20px; }
    #{{ sid }} .sm-wo__thumb { width: 72px; height: 72px; }
    #{{ sid }} .sm-wo__btn { grid-column: auto; }
  }
</style>

<div id="{{ sid }}" class="sm-wo">
<div class="sm-wrap sm-wo__grid">
  <div class="sm-wo__media">
    <div class="sm-wo__photo sm-media">{%- if section.settings.image_theme != blank -%}<img src="{{ section.settings.image_theme | asset_url }}" width="1000" height="1000" loading="lazy" alt="">{%- elsif section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 90vw', class: '' }}{%- else -%}{{ 'product-3' | placeholder_svg_tag: 'sm-ph ' }}{%- endif -%}</div>
    {%- if section.settings.sticker != blank -%}<span class="sm-wo__sticker">{{ section.settings.sticker | escape }}</span>{%- endif -%}
  </div>
  <div class="sm-wo__txt">
    {%- if section.settings.eyebrow != blank -%}<p class="sm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="sm-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="sm-sub sm-wo__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    <ul class="sm-wo__signs" role="list">
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/></svg><span>{{ block.settings.text | escape }}</span></li>{%- endfor -%}
    </ul>
    {%- if section.settings.swap_title != blank -%}
      <div class="sm-wo__swap">
        <span class="sm-wo__thumb sm-media">{%- if section.settings.swap_image_theme != blank -%}<img src="{{ section.settings.swap_image_theme | asset_url }}" width="200" height="200" loading="lazy" alt="">{%- elsif section.settings.swap_image != blank -%}{{ section.settings.swap_image | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '80px', class: '' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'sm-ph ' }}{%- endif -%}</span>
        <div class="sm-wo__swap-txt"><p class="sm-wo__swap-t">{{ section.settings.swap_title | escape }}</p>{%- if section.settings.swap_text != blank -%}<p>{{ section.settings.swap_text | escape }}</p>{%- endif -%}</div>
        {%- if section.settings.btn_label != blank -%}<a class="sm-btn sm-wo__btn" href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_label | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
</div>

{% schema %}
{
  "name": "SM Accroche confort",
  "tag": "section",
  "class": "sm-shell sm-wo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "image_theme",
      "label": "Photo du thème (facultatif)",
      "info": "Fichier du thème (ex. hp-nuage-echelle.jpg). Remplace la photo choisie au-dessus."
    },
    {
      "type": "text",
      "id": "sticker",
      "label": "Pastille sur la photo",
      "default": "Du moelleux à chaque pas"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petite ligne au-dessus du titre",
      "default": "Au quotidien"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Vos pieds fatiguent en fin de journée ?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "La semelle livrée avec vos chaussures est souvent fine et plate. Glissez à la place un vrai coussin de mousse, pensé pour les journées qui comptent."
    },
    {
      "type": "header",
      "content": "Encadré en bas"
    },
    {
      "type": "image_picker",
      "id": "swap_image",
      "label": "Photo ronde du produit"
    },
    {
      "type": "text",
      "id": "swap_image_theme",
      "label": "Photo ronde : fichier du thème (facultatif)",
      "info": "Fichier du thème (ex. hp-nuage-echelle.jpg). Remplace la photo choisie au-dessus."
    },
    {
      "type": "text",
      "id": "swap_title",
      "label": "Titre",
      "default": "Essayez la Semelle Heelo"
    },
    {
      "type": "text",
      "id": "swap_text",
      "label": "Texte",
      "default": "Une mousse épaisse et aérée, dans toutes vos chaussures."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Bouton : texte",
      "default": "Je découvre"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Bouton : lien"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#eff6f9"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texte et titres",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Bouton : fond",
      "default": "#13283a"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Bouton : texte",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Bouton : survol",
      "default": "#22405a"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#6fcfc8"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Bordures",
      "default": "#d3e3ec"
    },
    {
      "type": "header",
      "content": "Polices"
    },
    {
      "type": "font_picker",
      "id": "font_head",
      "label": "Police des titres",
      "default": "archivo_n7"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Police du texte",
      "default": "karla_n4"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Marge haute",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "sign",
      "name": "Moment",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Moment du quotidien"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SM Accroche confort",
      "blocks": [
        {
          "type": "sign",
          "settings": {
            "text": "Debout toute la journée au travail"
          }
        },
        {
          "type": "sign",
          "settings": {
            "text": "Sur des sols durs : carrelage, béton, entrepôt"
          }
        },
        {
          "type": "sign",
          "settings": {
            "text": "Pendant les longues balades"
          }
        },
        {
          "type": "sign",
          "settings": {
            "text": "Dans des chaussures de ville un peu raides"
          }
        }
      ]
    }
  ]
}
{% endschema %}

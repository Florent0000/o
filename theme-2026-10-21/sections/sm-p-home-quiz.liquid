{% raw %}<style>
#sm-hz{background:#e4f0f6;color:#13283a;font-family:Karla,'Helvetica Neue',Arial,sans-serif;padding:72px 0;scroll-margin-top:80px}
#sm-hz *{box-sizing:border-box}
#sm-hz .hf__wrap{max-width:880px;margin:0 auto;padding:0 20px}
#sm-hz .hf__eb{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#17807b;margin:0 0 8px;text-align:center}
#sm-hz h2{font-family:Archivo,'Helvetica Neue',Arial,sans-serif;font-size:clamp(28px,3.6vw,42px);line-height:1.08;letter-spacing:-.02em;margin:0 0 8px;text-align:center}
#sm-hz .hf__sub{color:#52697b;margin:0 0 28px;text-align:center;font-size:16px}
#sm-hz .hf__card{background:#fff;border:1px solid #d3e3ec;border-radius:20px;padding:28px;box-shadow:0 14px 40px rgba(19,40,58,.08)}
#sm-hz .hf__top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;font-size:14px;color:#52697b;font-weight:700}
#sm-hz .hf__back{background:none;border:0;color:#13283a;font:700 14px Karla,Arial,sans-serif;cursor:pointer;padding:6px 0;visibility:hidden}
#sm-hz .hf__bar{height:6px;border-radius:9px;background:#e4f0f6;overflow:hidden;margin-bottom:22px}
#sm-hz .hf__bar i{display:block;height:100%;width:25%;background:#17807b;border-radius:9px;transition:width .3s}
#sm-hz .hf__q{font-family:Archivo,Arial,sans-serif;font-size:clamp(20px,2.4vw,26px);font-weight:700;margin:0 0 18px}
#sm-hz .hf__opts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
#sm-hz .hf__opt{display:flex;align-items:center;gap:12px;min-height:76px;text-align:left;background:#f6fafc;border:2px solid #d3e3ec;border-radius:14px;padding:16px;font:600 16px/1.3 Karla,Arial,sans-serif;color:#13283a;cursor:pointer;transition:border-color .15s,background .15s,transform .15s}
#sm-hz .hf__opt:hover{border-color:#6fcfc8;background:#fff;transform:translateY(-1px)}
#sm-hz .hf__opt small{display:block;font-weight:500;color:#52697b;font-size:14px;margin-top:2px}
#sm-hz .hf__opt b{flex:none;width:40px;height:40px;border-radius:50%;background:#e4f0f6;display:flex;align-items:center;justify-content:center;font-size:20px}
#sm-hz .hf__res{display:none;grid-template-columns:220px 1fr;gap:24px;align-items:center}
#sm-hz .hf__res img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:16px;background:#f6fafc}
#sm-hz .hf__rtag{display:inline-block;background:#6fcfc8;color:#13283a;font-weight:700;font-size:13px;padding:4px 12px;border-radius:99px;margin-bottom:8px}
#sm-hz .hf__rname{font-family:Archivo,Arial,sans-serif;font-size:28px;font-weight:800;margin:0}
#sm-hz .hf__rprice{color:#17807b;font-weight:700;font-size:18px;margin:2px 0 10px}
#sm-hz .hf__rwhy{margin:0 0 16px;color:#22405a;line-height:1.5}
#sm-hz .hf__racts{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
#sm-hz .hf__btn{display:inline-flex;align-items:center;gap:8px;min-height:52px;padding:0 26px;border-radius:999px;background:#13283a;color:#fff;font-weight:700;text-decoration:none;font-size:16px}
#sm-hz .hf__btn:hover{background:#22405a}
#sm-hz .hf__again{background:none;border:0;font:700 15px Karla,Arial,sans-serif;color:#13283a;text-decoration:underline;cursor:pointer}
#sm-hz .hf__also{margin-top:18px;padding-top:16px;border-top:1px solid #e4f0f6;font-size:15px;color:#52697b}
#sm-hz .hf__also a{color:#17807b;font-weight:700}
#sm-hz .hf__note{margin:14px 0 0;font-size:13px;color:#52697b;text-align:center}
@media (max-width:640px){#sm-hz{padding:52px 0}#sm-hz .hf__card{padding:20px}#sm-hz .hf__opts{grid-template-columns:1fr;gap:10px}#sm-hz .hf__opt{padding:14px}#sm-hz .hf__res{grid-template-columns:1fr;gap:16px}#sm-hz .hf__res img{max-width:260px;margin:0 auto}}
</style>
<div id="sm-hz"><div class="hf__wrap" id="trouver-ma-semelle">
<p class="hf__eb">Trouver ma semelle</p><h2>Le bon modèle en 4 questions</h2><p class="hf__sub">Répondez en 20 secondes, on vous conseille le produit qui vous va.</p>
<div class="hf__card"><div class="hf__step"><div class="hf__top"><button type="button" class="hf__back">&#x2190; Retour</button><span class="hf__count">Question 1 sur 4</span></div>
<div class="hf__bar"><i></i></div><p class="hf__q"></p><div class="hf__opts"></div></div>
<div class="hf__res"><img alt=""><div><span class="hf__rtag">Notre conseil pour vous</span><p class="hf__rname"></p><p class="hf__rprice"></p><p class="hf__rwhy"></p>
<div class="hf__racts"><a class="hf__btn" href="#">Voir le produit <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a><button type="button" class="hf__again">Refaire le test</button></div><p class="hf__also"></p></div></div></div>
<p class="hf__note">Un conseil de confort, pas un avis médical. Vous avez 30 jours pour essayer.</p></div></div>
<script>(function(){
var root=document.getElementById('sm-hz');if(!root)return;
var Q=[
 {k:'age',q:'Quel âge avez-vous ?',o:[['moins','Moins de 18 ans','','🧒'],['18','18 à 39 ans','','🙂'],['40','40 à 59 ans','','😊'],['60','60 ans et plus','','👵']]},
 {k:'use',q:'Vous les porterez surtout…',o:[['travail','Au travail','Debout ou en marchant longtemps','💼'],['sport','Pour le sport','Course, salle, randonnée','👟'],['maison','À la maison','Dedans, pieds nus ou en chaussons','🏠'],['autre','Autre','Ville, balades, voyages','🚶']]},
 {k:'feel',q:'Quel confort cherchez-vous ?',o:[['doux','Moelleux','Une mousse épaisse et douce','☁️'],['ferme','Fin et ferme','Prend peu de place dans la chaussure','⚫'],['haut','Gagner un peu de hauteur','Jusqu&#x27;à 3,5 cm au talon','📏'],['sais','Je ne sais pas','On choisit pour vous','🤔']]},
 {k:'shoe',q:'Dans quelles chaussures ?',o:[['baskets','Baskets','Sport ou tous les jours','👟'],['ville','Chaussures de ville','Mocassins, bottines, derbies','👞'],['secu','Chaussures de travail','Sécurité, chantier, cuisine','🥾'],['ouvert','Pas de chaussures fermées','Je cherche plutôt des sandales','🩴']]}
];
var P={
 nuage:{n:'Semelle Heelo',p:'dès 29,95 € la paire',h:'/products/semelle-nuage',i:'{% endraw %}{{ 'hp-nuage-panier.jpg' | asset_url }}{% raw %}'},
 carbone:{n:'Semelle Carbone',p:'39,90 €',h:'/products/semelle-carbone',i:'{% endraw %}{{ 'hp-carbone-panier.jpg' | asset_url }}{% raw %}'},
 rehausse:{n:'Semelle Rehausse',p:'29,95 € la paire',h:'/products/semelle-rehausse',i:'{% endraw %}{{ 'hp-rh-mousse.jpg' | asset_url }}{% raw %}'},
 claquettes:{n:'Claquettes comfort',p:'24,95 €',h:'/products/claquettes-comfort',i:'claquettes/img/c-noir-classique.jpg'},
 tongs:{n:'Tongs comfort',p:'24,95 €',h:'/products/tongs-comfort',i:'tongs/img/c-noir.jpg'},
 rouleau:{n:'Rouleau de massage',p:'14,95 €',h:'/products/rouleau-massage',i:'{% endraw %}{{ 'hp-ro-pose.jpg' | asset_url }}{% raw %}'}
};
var A={},step=0,$=function(c){return root.querySelector(c);};
function draw(){var q=Q[step];$('.hf__count').textContent='Question '+(step+1)+' sur '+Q.length;$('.hf__bar i').style.width=((step+1)/Q.length*100)+'%';
 $('.hf__q').textContent=q.q;$('.hf__back').style.visibility=step?'visible':'hidden';
 $('.hf__opts').innerHTML=q.o.map(function(o){return '<button type="button" class="hf__opt" data-v="'+o[0]+'"><span>'+o[1]+(o[2]?'<small>'+o[2]+'</small>':'')+'</span></button>';}).join('');}
function pick(){var u=A.use,f=A.feel,sh=A.shoe,r,why,also=null;
 if(sh==='ouvert'){r=(u==='maison')?'claquettes':'tongs';why=(r==='claquettes')?'Pour la maison, des claquettes en mousse souple qui s&#x27;enfilent en une seconde.':'Pour sortir sans chaussures fermées, des tongs en mousse EVA avec une bride douce.';also=(r==='claquettes')?'tongs':'claquettes';}
 else if(f==='haut'){r='rehausse';why='Elle se glisse dans vos chaussures et vous fait gagner jusqu&#x27;à 3,5 cm au talon, avec la même mousse épaisse que la Semelle Heelo. Le gain réel dépend de vos chaussures.';also='nuage';}
 else if(f==='ferme'||(sh==='ville'&&f!=='doux')){r='carbone';why='Ultra-fine, elle prend très peu de place : idéale dans des chaussures de ville ajustées.';also='nuage';}
 else{r='nuage';why=(u==='travail'||sh==='secu')?'Une mousse épaisse et moelleuse pour les longues journées debout, qui se glisse dans vos chaussures de travail.':(u==='sport')?'Une mousse épaisse et aérée qui amortit chaque pas, dans vos baskets.':'Une mousse épaisse et moelleuse, pour plus de confort à chaque pas.';also=(u==='travail'||u==='sport'||sh==='secu')?'rouleau':'carbone';}
 if(A.age==='60'&&r==='carbone'){why+=' Si vous préférez plus de moelleux, la Semelle Heelo est faite pour ça.';}
 return {r:r,why:why,also:also};}
function result(){var x=pick(),pr=P[x.r];$('.hf__step').style.display='none';var R=$('.hf__res');R.style.display='grid';
 R.querySelector('img').src=pr.i;R.querySelector('img').alt=pr.n;$('.hf__rname').textContent=pr.n;$('.hf__rprice').textContent=pr.p;$('.hf__rwhy').innerHTML=x.why;$('.hf__btn').setAttribute('href',pr.h);
 var a=P[x.also];$('.hf__also').innerHTML=x.also==='rouleau'?'Pour le soir, après une longue journée : <a href="'+a.h+'">'+a.n+'</a> ('+a.p+').':'À voir aussi : <a href="'+a.h+'">'+a.n+'</a> ('+a.p+').';}
root.addEventListener('click',function(e){var o=e.target.closest('.hf__opt');if(o){A[Q[step].k]=o.dataset.v;if(step<Q.length-1){step++;draw();}else result();return;}
 if(e.target.closest('.hf__back')&&step>0){step--;draw();return;}
 if(e.target.closest('.hf__again')){A={};step=0;$('.hf__res').style.display='none';$('.hf__step').style.display='';draw();}});
draw();
})();</script>{% endraw %}

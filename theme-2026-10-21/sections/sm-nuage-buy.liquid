                  <span class="sm-nb__pack-price"><span class="sm-nb__now"><b data-pack-now>{{ per | money }}</b>{%- if section.settings.each_label != blank -%}<i>{{ section.settings.each_label | escape }}</i>{%- endif -%}</span><s data-pack-was{% if ref <= per %} hidden{% endif %} aria-label="au lieu de {{ ref | money }}">{{ ref | money }}</s></span>
                </span>
                {%- if per_pair -%}
                  <span class="sm-nb__pairs">
                    <span class="sm-nb__pairs-h"><span>{{ section.settings.pairs_label | escape }}</span>
                      {%- if section.settings.guide_label != blank and section.settings.guide_link != blank -%}<a class="sm-pdp__guide" href="{{ section.settings.guide_link }}">{{ section.settings.guide_label | escape }}</a>{%- endif -%}
                    </span>
                    {%- for k in (1..block.settings.qty) -%}
                      <span class="sm-nb__pair{% if k > paid %} is-free{% endif %}">
                        <span class="sm-nb__pair-n">{% if k > paid %}<svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12"/><path d="M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zM12 8c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg>{% else %}#{{ k }}{% endif %}</span>
                        <span class="sm-nb__sel-w">
                          <select class="sm-nb__sel" data-pair aria-label="{{ section.settings.pairs_label | escape }} {{ k }}">
                            {%- assign po = p.options_with_values[pair_opt] -%}{%- for value in po.values -%}{%- assign vn = value | append: '' -%}<option value="{{ vn | escape }}"{% if vn == current.options[pair_opt] %} selected{% endif %}>{{ vn | escape }}</option>{%- endfor -%}
                          </select><svg class="sm-nb__chev" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                        {%- if k > paid -%}<span class="sm-nb__pair-free">Offerte</span>{%- endif -%}
                      </span>
                    {%- endfor -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.free > 0 -%}
                  <span class="sm-nb__band sm-nb__band--gift">
                    <span class="sm-nb__thumb sm-nb__thumb--gift">
                      {%- liquid
                        assign gm = p.media.first
                        if section.settings.gift_match != blank
                          for m in p.media
                            assign mu = m | image_url: width: 10
                            if mu contains section.settings.gift_match
                              assign gm = m
                              break
                            endif
                          endfor
                        endif
                      -%}{%- if section.settings.gift_image != blank -%}{{ section.settings.gift_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- elsif p.media.size > 0 -%}{{ gm | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12"/><path d="M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zM12 8c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg>{%- endif -%}
                      <i><svg class="sm-ic" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12"/><path d="M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zM12 8c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg></i>
                    </span>
                    <span class="sm-nb__band-t">+ {{ block.settings.free }} paire{% if block.settings.free > 1 %}s{% endif %} offerte{% if block.settings.free > 1 %}s{% endif %}</span>
                    <span class="sm-nb__band-v"><s data-pack-free>{{ free_value | money }}</s><b>{{ section.settings.free_word | escape }}</b></span>
                  </span>
                {%- endif -%}
                {%- if block.settings.free_shipping -%}
                  <span class="sm-nb__band sm-nb__band--ship">
                    <span class="sm-nb__thumb sm-nb__thumb--ship">
                      {%- if section.settings.ship_image != blank -%}{{ section.settings.ship_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<svg class="sm-nb__art" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><rect width="64" height="64" rx="12" fill="#6fcfc8"/><path d="M5 25h8M3 31h10M7 37h6" stroke="#13283a" stroke-width="2.6" stroke-linecap="round"/><rect x="16" y="19" width="25" height="21" rx="3" fill="#f6fafc" stroke="#13283a" stroke-width="2.6"/><path d="M22 27.5c2-2.6 5.5-2.6 7 0 1.4-1.6 4.2-1 4.4 1.3 1.8.2 2.4 2.7.2 3.4H22.3c-2 0-2.3-3.4-.3-4.7z" fill="#6fcfc8"/><path d="M41 25h8.5l6.5 7.5V40H41z" fill="#13283a"/><path d="M44 27.6h4.4l3.9 4.6H44z" fill="#f6fafc"/><circle cx="24" cy="42" r="5.2" fill="#13283a" stroke="#6fcfc8" stroke-width="2"/><circle cx="24" cy="42" r="1.8" fill="#f6fafc"/><circle cx="48.5" cy="42" r="5.2" fill="#13283a" stroke="#6fcfc8" stroke-width="2"/><circle cx="48.5" cy="42" r="1.8" fill="#f6fafc"/></svg>{%- endif -%}
                    </span>
                    <span class="sm-nb__band-t">{{ section.settings.ship_label | escape }}</span>
                    <span class="sm-nb__band-v">{%- if section.settings.ship_value != blank -%}<s>{{ section.settings.ship_value | escape }}</s>{%- endif -%}<b>{{ section.settings.free_word | escape }}</b></span>
                  </span>
                {%- endif -%}
              </label>
            {%- endif -%}
          {%- endfor -%}
        </fieldset>
      {%- endif -%}
      <input type="hidden" name="quantity" value="1" data-qty-input>

      {%- if section.settings.half_title != blank -%}
        <div class="sm-pdp__half">
          <p class="sm-pdp__half-t">{{ section.settings.half_title | escape }}</p>
          <p>{{ section.settings.half_text | escape }}</p>
        </div>
      {%- endif -%}

      <button type="submit" name="add" class="sm-btn sm-pdp__add" data-add{% unless current.available %} disabled{% endunless %}>
        <span data-add-label>{% if current.available %}{{ section.settings.add_label | escape }}{% else %}Épuisé{% endif %}</span>
      </button>
    {% endform %}

    {%- if section.settings.show_payment -%}
      <ul class="sm-pdp__pay" role="list" aria-label="Moyens de paiement">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'sm-pdp__pay-ic' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.tip_title != blank -%}
      <div class="sm-pdp__tip">
        <p class="sm-pdp__tip-t">{{ section.settings.tip_title | escape }}</p>
        <p>{{ section.settings.tip_text | escape }}</p>
      </div>
    {%- endif -%}

    <div class="sm-pdp__rows">
      {%- for block in section.blocks -%}{%- if block.type != 'row' -%}{%- continue -%}{%- endif -%}
        <details class="sm-pdp__row" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
          <summary>{{ block.settings.title | escape }}<svg class="sm-pdp__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></summary>
          <div class="sm-pdp__row-body">
            {%- if block.settings.use_description and p.description != blank -%}{{ p.description }}{%- else -%}{{ block.settings.content }}{%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
<script type="application/json" data-pdp-json>{"variants": {{ p.variants | json }}, "money": {{ shop.money_format | json }}, "add": {{ section.settings.add_label | json }}}</script>
{%- endif -%}
</div>

<script>
(function () {
  var root = document.getElementById('{{ sid }}');
  if (!root) return;
  /* gallery */
  var track = root.querySelector('.sm-pdp__slides');
  var slides = Array.prototype.slice.call(root.querySelectorAll('.sm-pdp__slide'));
  var thumbs = Array.prototype.slice.call(root.querySelectorAll('.sm-pdp__thumb'));
  var cur = root.querySelector('.sm-pdp__cur');
  var tot = root.querySelector('.sm-pdp__tot');
  var cap = root.querySelector('[data-cap]');
  var vis = slides.slice();
  var idx = 0;
  function show(k) {
    if (!vis.length) return;
    idx = (k + vis.length) % vis.length;
    track.scrollTo({ left: track.clientWidth * idx });
  }
  function mark() {
    var k = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
    if (k > vis.length - 1) k = vis.length - 1;
    if (k < 0) k = 0;
    idx = k;
    var real = slides.indexOf(vis[k]);
    thumbs.forEach(function (t) { t.classList.toggle('is-active', +t.getAttribute('data-go') === real); });
    if (cur) cur.textContent = k + 1;
    if (cap) { var im = vis[k] && vis[k].querySelector('img'); cap.textContent = im ? (im.getAttribute('alt') || '') : ''; }
  }
  root.__smFilter = function (c) {
    if (!c || !track) return;
    c = String(c).toLowerCase();
    if (!slides.some(function (s) { return s.getAttribute('data-c') === c; })) return;
    vis = slides.filter(function (s) { var x = s.getAttribute('data-c'); return !x || x === c; });
    slides.forEach(function (s) { s.hidden = vis.indexOf(s) < 0; });
    thumbs.forEach(function (t) { t.hidden = vis.indexOf(slides[+t.getAttribute('data-go')]) < 0; });
    if (tot) tot.textContent = vis.length;
    track.scrollTo({ left: 0 });
    idx = 0;
    mark();
  };
  if (track && slides.length) {
    track.addEventListener('scroll', function () { window.requestAnimationFrame(mark); }, { passive: true });
    thumbs.forEach(function (t) { t.addEventListener('click', function () { show(vis.indexOf(slides[+t.getAttribute('data-go')])); }); });
    Array.prototype.forEach.call(root.querySelectorAll('.sm-pdp__arrow'), function (b) { b.addEventListener('click', function () { show(idx + (+b.getAttribute('data-step'))); }); });
    mark();
  }
  /* variants */
  var dataEl = root.querySelector('[data-pdp-json]');
  if (!dataEl) return;
  var data = JSON.parse(dataEl.textContent);
  var groups = Array.prototype.slice.call(root.querySelectorAll('[data-opt]'));
  var idInput = root.querySelector('[data-variant-id]');
  var addBtn = root.querySelector('[data-add]');
  var addLabel = root.querySelector('[data-add-label]');
  var priceEl = root.querySelector('[data-price]');
  function money(cents) {
    var fmt = data.money || '{' + '{amount}}';
    var n = (cents / 100);
    return fmt.replace(/\{\{\s*(\w+)\s*\}\}/, function (m, k) {
      var dec = k.indexOf('no_decimals') > -1 ? 0 : 2;
      var s = n.toFixed(dec).split('.');
      var comma = k.indexOf('comma') > -1;
      s[0] = s[0].replace(/\B(?=(\d{3})+(?!\d))/g, comma ? '.' : ',');
      return s.join(comma ? ',' : '.');
    });
  }
  function selected() {
    return groups.map(function (g) {
      var a = g.querySelector('.is-active');
      return { i: +g.getAttribute('data-opt'), v: a ? a.getAttribute('data-value') : null };
    });
  }
  function find(sel) {
    return data.variants.find(function (v) {
      return sel.every(function (s) { return v.options[s.i] === s.v; });
    });
  }
  var qtyInput = root.querySelector('[data-qty-input]');
  var packEls = Array.prototype.slice.call(root.querySelectorAll('[data-pack]'));
  var lastV = null;
  function packs(v) {
    lastV = v;
    var q = 1;
    packEls.forEach(function (el) {
      var n = +el.getAttribute('data-n'), f = +el.getAttribute('data-free'), o = +el.getAttribute('data-off');
      var total = Math.floor(v.price * Math.max(n - f, 1) * (100 - o) / 100), per = Math.floor(total / n);
      var ref = (el.getAttribute('data-cmp') === '1' && v.compare_at_price > v.price) ? v.compare_at_price : v.price;
      var save = ref * n - total, pct = Math.floor(save * 100 / (ref * n));
      var a = el.querySelector('[data-pack-now]'), b = el.querySelector('[data-pack-was]'), c = el.querySelector('[data-pack-pct]'), d = el.querySelector('[data-pack-save]'), g = el.querySelector('[data-pack-free]');
      if (a) a.textContent = money(per);
      if (b) { b.textContent = money(ref); b.hidden = ref <= per; }
      if (c) { c.textContent = '-' + pct + ' %'; c.hidden = pct < 1; }
      if (d) { d.textContent = 'Vous économisez ' + money(save); d.hidden = save < 1; }
      if (g) g.textContent = money(v.price * f);
      var r = el.querySelector('input');
      el.classList.toggle('is-active', r.checked);
      if (r.checked) q = n;
    });
    if (qtyInput) qtyInput.value = q;
    addLabel.textContent = v.available ? data.add : 'Épuisé';
  }
  packEls.forEach(function (el) { el.querySelector('input').addEventListener('change', function () { if (lastV) packs(lastV); }); });
  /* one size per pair: the active pack's selects become cart lines */
  var form = root.querySelector('.sm-pdp__form');
  if (form && root.querySelector('[data-pair]')) {
    form.addEventListener('submit', function () {
      var act = root.querySelector('[data-pack].is-active') || packEls[0];
      if (!act) return;
      var count = {}, order = [];
      var pIdx = groups.length - 1;
      act.querySelectorAll('[data-pair]').forEach(function (sel) {
        var s2 = selected().filter(function (x) { return x.i !== pIdx; });
        s2.push({ i: pIdx, v: sel.value });
        var pv = find(s2);
        if (!pv) return;
        var id = String(pv.id);
        if (!count[id]) { count[id] = 0; order.push(id); }
        count[id]++;
      });
      if (!order.length) return;
      form.querySelectorAll('[data-pair-line]').forEach(function (x) { x.remove(); });
      idInput.removeAttribute('name');
      if (qtyInput) qtyInput.removeAttribute('name');
      order.forEach(function (id, i) {
        [['id', id], ['quantity', count[id]]].forEach(function (kv) {
          var h = document.createElement('input');
          h.type = 'hidden'; h.name = 'items[' + i + '][' + kv[0] + ']'; h.value = kv[1]; h.setAttribute('data-pair-line', '');
          form.appendChild(h);
        });
      });
    });
  }
  function refresh() {
    var sel = selected();
    var v = find(sel);
    groups.forEach(function (g) {
      var gi = +g.getAttribute('data-opt');
      Array.prototype.forEach.call(g.querySelectorAll('[data-value]'), function (b) {
        var trial = sel.map(function (s) { return s.i === gi ? { i: s.i, v: b.getAttribute('data-value') } : s; });
        var tv = find(trial);
        b.classList.toggle('is-off', !tv || !tv.available);
      });
      var lab = g.querySelector('[data-opt-label]');
      var act = g.querySelector('.is-active');
      if (lab && act) lab.textContent = act.getAttribute('data-value');
    });
    if (!v) { addBtn.disabled = true; addLabel.textContent = 'Indisponible'; return; }
    idInput.value = v.id;
    addBtn.disabled = !v.available;
    packs(v);
    priceEl.innerHTML = '<span class="sm-pdp__now">' + money(v.price) + '</span>' + (v.compare_at_price > v.price ? '<s class="sm-pdp__was">' + money(v.compare_at_price) + '</s>' : '');
    if (window.history.replaceState && !window.Shopify?.designMode) {
      var u = new URL(window.location.href); u.searchParams.set('variant', v.id); window.history.replaceState({}, '', u.toString());
    }
  }
  groups.forEach(function (g) {
    g.addEventListener('click', function (e) {
      var b = e.target.closest('[data-value]');
      if (!b) return;
      Array.prototype.forEach.call(g.querySelectorAll('[data-value]'), function (x) { x.classList.remove('is-active'); x.setAttribute('aria-pressed', 'false'); });
      b.classList.add('is-active'); b.setAttribute('aria-pressed', 'true');
      refresh();
    });
  });
  refresh();
})();
</script>

